#!/bin/sh
set -eu

ENVY_VERSION=0.1.0-dev

envy_help() (
    printf '%s\n' \
        'Usage: envy <command>' \
        '' \
        'Commands:' \
        '  init <url>    Create or join an encrypted store' \
        '  unlock        Recover the local identity with the store passphrase' \
        '  rekey         Replace the store key and track secrets needing provider rotation' \
        '  set NAME      Store a value from a hidden prompt or stdin' \
        '  get NAME      Print a stored value exactly' \
        "  edit NAME     Edit or create a secret with \$EDITOR (default: vi)" \
        '  ls            List secret names without decrypting' \
        '  rm [--force] NAME  Remove a secret; refuse central mapping references' \
        '  mv OLD NEW    Rename a secret and update central mapping references' \
        '  project ls|show|edit|rm  Manage central mappings (show/edit --global)' \
        '  link [--local] [name]  Link this checkout or directory to a project' \
        '  unlink        Remove the current local link, or its origin link' \
        '  allow         Review and approve the current project .envy on this machine' \
        '  run [--project <name>] -- cmd...  Run with the layered environment' \
        '  env [--project <name>]  Print shell exports for the layered environment' \
        '  status        Show project, layer sources and cached machine/store state' \
        '  hook          Print the bash/zsh ambient hook for eval' \
        '  config [ambient|quiet on|off]  Show or change machine-local settings' \
        '  config sync_interval <seconds>  Set the background refresh interval' \
        '  check         Validate store mappings and the current .envy; list unused secrets' \
        '  pull          Fetch and rebase local commits onto the remote' \
        '  push          Push local commits, retrying once after a pull' \
        '  sync          Pull, then push local commits' \
        '  doctor        Diagnose dependencies, store and machine setup' \
        '  self-update   Install the latest tagged release atomically' \
        '  uninstall     Remove the tool and hooks; offer to delete local store/key' \
        '  version       Print the envy version' \
        '  help          Show this help'
)

envy_error() {
    printf 'envy: %s\n' "$1" >&2
    exit 1
}

envy_paths() {
    envy_data=${XDG_DATA_HOME:-$HOME/.local/share}/envy
    envy_store=$envy_data/store
    envy_identity=$envy_data/identity
    envy_state=${XDG_STATE_HOME:-$HOME/.local/state}/envy
    envy_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/envy
    envy_config_file=$envy_config_dir/config
}

# Settings are data, never shell code. Do not include input in diagnostics.
envy_settings_load() {
    envy_ambient=on
    envy_quiet=off
    envy_sync_interval=14400
    if [ -e "$envy_config_file" ]; then
        if [ ! -f "$envy_config_file" ] || [ ! -r "$envy_config_file" ]; then
            envy_error 'cannot read machine settings'
        fi
        while IFS= read -r envy_setting || [ -n "$envy_setting" ]; do
            case $envy_setting in
                ambient=on|ambient=off) envy_ambient=${envy_setting#*=} ;;
                quiet=on|quiet=off) envy_quiet=${envy_setting#*=} ;;
                sync_interval=*)
                    envy_sync_interval=${envy_setting#*=}
                    case $envy_sync_interval in
                        ''|*[!0-9]*) envy_error 'invalid machine settings' ;;
                    esac
                    ;;
                ''|'#'*) ;;
                *) envy_error 'invalid machine settings' ;;
            esac
        done < "$envy_config_file"
    fi
}

envy_settings_print() {
    printf 'ambient=%s\nquiet=%s\nsync_interval=%s\n' \
        "$envy_ambient" "$envy_quiet" "$envy_sync_interval"
}

envy_config() {
    if [ "$#" -eq 0 ]; then
        envy_paths
        envy_settings_load
        envy_settings_print
        return
    fi
    [ "$#" -eq 2 ] || envy_error 'usage: envy config [ambient|quiet on|off|sync_interval <seconds>]'
    case $1:$2 in
        ambient:on|ambient:off|quiet:on|quiet:off) ;;
        sync_interval:*)
            case $2 in
                ''|*[!0-9]*) envy_error 'sync_interval must be a non-negative number of seconds' ;;
            esac
            ;;
        *) envy_error 'usage: envy config [ambient|quiet on|off|sync_interval <seconds>]' ;;
    esac
    # Share the machine lock to serialize settings updates, even before init.
    envy_begin
    envy_settings_load
    case $1 in
        ambient) envy_ambient=$2 ;;
        quiet) envy_quiet=$2 ;;
        sync_interval) envy_sync_interval=$2 ;;
    esac
    mkdir -p "$envy_config_dir" || envy_error 'cannot create settings directory'
    envy_temp=$(mktemp -d "$envy_config_dir/.config.XXXXXX") ||
        envy_error 'cannot create temporary directory'
    envy_settings_print > "$envy_temp/config" || envy_error 'cannot write machine settings'
    mv "$envy_temp/config" "$envy_config_file" || envy_error 'cannot save machine settings'
}

envy_cleanup() {
    trap '' HUP INT TERM
    [ -z "$envy_editor_pid" ] || kill "$envy_editor_pid" 2> /dev/null || :
    if [ -n "$envy_rekey_age_pid" ]; then
        kill "$envy_rekey_age_pid" 2> /dev/null || :
        wait "$envy_rekey_age_pid" 2> /dev/null || :
    fi
    # age can leave echo disabled when interrupted. Restore after it has
    # stopped, through the controlling terminal even if stdin is redirected.
    if [ -n "$envy_rekey_tty_state" ]; then
        (stty "$envy_rekey_tty_state" < /dev/tty) 2> /dev/null || :
    fi
    [ -z "$envy_tty_state" ] || stty "$envy_tty_state" 2> /dev/null || :
    if [ "$envy_rekey_restore" = yes ]; then
        # Rekey starts from a clean store. Before commit succeeds, restore the
        # pulled snapshot and old identity together on failure or interruption.
        git -C "$envy_store" reset --hard "$envy_rekey_before" > /dev/null 2>&1 || :
        [ "$envy_rekey_had_pending" = yes ] || rm -f "$envy_store/rotation-pending"
        mv "$envy_temp/old-identity" "$envy_identity" || :
    fi
    [ -z "$envy_temp" ] || rm -rf "$envy_temp"
    [ -z "$envy_stage" ] || rm -rf "$envy_stage"
    [ -z "$envy_fetch_temp" ] || rm -f "$envy_fetch_temp"
    if [ "$envy_rebasing" = yes ] &&
        { [ -d "$envy_store/.git/rebase-merge" ] || [ -d "$envy_store/.git/rebase-apply" ]; }; then
        git -C "$envy_store" rebase --abort > /dev/null 2>&1 || :
    fi
    # Only remove our own owner record and an empty lock, never another owner.
    if [ -n "$envy_lock" ]; then
        rmdir "$envy_lock/$$" 2> /dev/null || :
        rmdir "$envy_lock" 2> /dev/null || :
    fi
}

envy_prepare() {
    envy_paths
    umask 077
    envy_tty_state=
    envy_editor_pid=
    envy_rekey_age_pid=
    envy_rekey_tty_state=
    envy_temp=
    envy_stage=
    envy_fetch_temp=
    envy_rebasing=no
    envy_rekey_restore=no
    envy_lock=
    trap 'envy_cleanup' 0
    trap 'exit 1' HUP INT TERM
}

envy_begin() {
    envy_prepare
    envy_lock=$envy_state/lock
    mkdir -p "$envy_state"
    envy_lock_started=$(date +%s)
    while :; do
        if mkdir "$envy_lock" 2> /dev/null; then
            # The PID directory is the owner record. Unlike a pid file it can
            # be reclaimed with rmdir, without deleting a replacement owner's
            # record when several processes recover the same stale lock.
            if mkdir "$envy_lock/$$" 2> /dev/null; then
                set -- "$envy_lock"/*
                # An empty lock might have been reclaimed before we published
                # our PID. Proceed only if we are its sole owner.
                if [ "$#" -eq 1 ] && [ "$1" = "$envy_lock/$$" ]; then
                    return
                fi
                rmdir "$envy_lock/$$" 2> /dev/null || :
            fi
        else
            for envy_owner in "$envy_lock"/*; do
                [ -d "$envy_owner" ] || continue
                envy_pid=${envy_owner##*/}
                case $envy_pid in ''|*[!0-9]*|0) continue ;; esac
                if ! kill -0 "$envy_pid" 2> /dev/null; then
                    rmdir "$envy_owner" 2> /dev/null || :
                fi
            done
        fi
        if rmdir "$envy_lock" 2> /dev/null; then
            continue
        fi
        if [ "$(($(date +%s) - envy_lock_started))" -ge 30 ]; then
            envy_error 'store busy; another envy process holds the lock'
        fi
        sleep 1
    done
}

envy_dependencies() {
    for envy_dependency in git age age-keygen; do
        command -v "$envy_dependency" > /dev/null 2>&1 ||
            envy_error "missing dependency: $envy_dependency"
    done
}

envy_name() {
    # Explicit ASCII characters avoid locale-dependent ranges in macOS sh.
    case $1 in
        ''|[!ABCDEFGHIJKLMNOPQRSTUVWXYZ_]*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*)
            envy_error 'invalid secret name; use [A-Z_][A-Z0-9_]*'
            ;;
    esac
}

envy_validate_store() (
    if [ ! -d "$1/.git" ] || [ ! -f "$1/format" ]; then
        envy_error 'store not initialized; run envy init <url>'
    fi
    envy_format=$(cat "$1/format")
    case $envy_format in
        1) ;;
        ''|*[!0-9]*) envy_error 'unsupported store format' ;;
        *)
            # awk handles large version numbers without shell integer overflow.
            if printf '%s\n' "$envy_format" | awk '{ exit !($0 + 0 > 1) }'; then
                envy_error 'unsupported store format; update envy to read this newer store'
            fi
            envy_error 'unsupported store format'
            ;;
    esac
)

# Read paths stay usable with a cached key when recovery metadata is damaged.
# Only readiness diagnostics require these regular, tracked store files.
# Keep this check and its recovery wording in sync with install_store_layout.
envy_validate_store_layout() (
    for envy_layout_file in identity.age recipient; do
        envy_layout_reason=
        if [ ! -e "$1/$envy_layout_file" ] && [ ! -L "$1/$envy_layout_file" ]; then
            envy_layout_reason='is missing'
        elif [ ! -f "$1/$envy_layout_file" ] || [ -L "$1/$envy_layout_file" ]; then
            envy_layout_reason='is not a regular file'
        elif ! git -C "$1" ls-files --error-unmatch -- "$envy_layout_file" > /dev/null 2>&1; then
            envy_layout_reason='is untracked'
        fi
        if [ -n "$envy_layout_reason" ]; then
            envy_error "store layout: $envy_layout_file $envy_layout_reason; restore it from history or a known-good machine"
        fi
    done
)

envy_check_identity() (
    [ -f "$2" ] || envy_error 'local identity missing; run envy unlock'
    envy_public=$(age-keygen -y "$2" 2> /dev/null) ||
        envy_error 'cannot read local identity; run envy unlock'
    if [ ! -f "$1/recipient" ] ||
        [ "$envy_public" != "$(cat "$1/recipient")" ]; then
        envy_error 'store public key does not match local identity; run envy unlock'
    fi
)

envy_require_store() {
    envy_paths
    envy_validate_store "$envy_store" || return 1
    envy_dependencies || return 1
    envy_check_identity "$envy_store" "$envy_identity"
}

envy_recover_identity() {
    [ -f "$1/identity.age" ] || envy_error 'store encrypted identity missing'
    # age reads the passphrase from the terminal, never stdin or an argument.
    age -d -o "$2" "$1/identity.age" 2> /dev/null ||
        envy_error 'could not unlock identity; check the store passphrase'
    chmod 600 "$2"
    envy_check_identity "$1" "$2"
}

envy_unlock() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy unlock'
    envy_dependencies
    envy_begin
    envy_validate_store "$envy_store"
    [ ! -d "$envy_identity" ] ||
        envy_error 'local identity path is a directory; move it aside and run envy unlock'
    envy_stage=$(mktemp -d "$envy_data/.unlock.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_recover_identity "$envy_store" "$envy_stage/identity"
    mv "$envy_stage/identity" "$envy_identity"
}

envy_git_identity() {
    if [ -z "$(git -C "$envy_store" config user.name || :)" ]; then
        git -C "$envy_store" config user.name envy
    fi
    if [ -z "$(git -C "$envy_store" config user.email || :)" ]; then
        git -C "$envy_store" config user.email envy@localhost
    fi
}

envy_clean_store() {
    # Check untracked files even when the user's status display hides them.
    envy_store_status=$(git -C "$envy_store" status --porcelain --untracked-files=all 2> /dev/null) ||
        envy_error 'could not inspect store cleanliness; resolve the repository error before writing or syncing'
    if [ -n "$envy_store_status" ] ||
        [ -d "$envy_store/.git/rebase-merge" ] ||
        [ -d "$envy_store/.git/rebase-apply" ] ||
        [ -f "$envy_store/.git/MERGE_HEAD" ]; then
        envy_error 'store has uncommitted changes or an unfinished operation; resolve them before writing or syncing'
    fi
}

envy_record_fetch() {
    # Readers must see a complete timestamp, even while a sync is in progress.
    [ ! -d "$envy_state/last-fetch" ] || return 1
    envy_fetch_temp=$envy_state/.last-fetch.$$
    if date +%s > "$envy_fetch_temp" &&
        mv "$envy_fetch_temp" "$envy_state/last-fetch"; then
        envy_fetch_temp=
        return 0
    fi
    rm -f "$envy_fetch_temp"
    envy_fetch_temp=
    return 1
}

envy_refresh_due() (
    envy_now=$(date +%s) || exit 1
    # awk treats leading zeroes as decimal and avoids shell integer overflow
    # for large intervals. Missing or damaged timestamps count as stale.
    if [ ! -f "$envy_state/last-fetch" ]; then
        exit 0
    fi
    LC_ALL=C awk -v now="$envy_now" -v interval="$envy_sync_interval" '
        NR == 1 && /^[0-9]+$/ { fetched = $0; valid = 1; next }
        { valid = 0 }
        END { exit (valid && now >= fetched && now - fetched < interval) }
    ' "$envy_state/last-fetch"
)

envy_refresh_background() (
    # Schedule only after the foreground has buffered its environment. All
    # descriptors are detached so eval/command substitution cannot wait for us.
    envy_paths
    [ -d "$envy_store/.git" ] || exit 0
    envy_settings_load
    envy_refresh_due || exit 0
    nohup sh "$0" sync --background < /dev/null > /dev/null 2>&1 &
) > /dev/null 2>&1

envy_fetch_rebase() {
    envy_sync_failure=
    envy_pull_changed=no
    envy_branch=$(git -C "$envy_store" symbolic-ref --quiet --short HEAD) || {
        envy_sync_failure=branch
        return 1
    }
    if ! git -C "$envy_store" fetch --quiet origin "$envy_branch" > /dev/null 2>&1; then
        envy_sync_failure=offline
        return 1
    fi
    envy_record_fetch || {
        envy_sync_failure=state
        return 1
    }
    envy_before=$(git -C "$envy_store" rev-parse HEAD) || {
        envy_sync_failure=rebase
        return 1
    }
    # Divergent commits encrypted with different identities cannot be merged:
    # even a clean text rebase could leave unreadable ciphertext in the store.
    if ! git -C "$envy_store" merge-base --is-ancestor HEAD FETCH_HEAD &&
        ! git -C "$envy_store" merge-base --is-ancestor FETCH_HEAD HEAD; then
        envy_remote_recipient=$(git -C "$envy_store" show FETCH_HEAD:recipient 2> /dev/null) || {
            envy_sync_failure=identity
            return 1
        }
        if [ "$envy_remote_recipient" != "$(cat "$envy_store/recipient")" ]; then
            envy_sync_failure=identity
            return 1
        fi
    fi
    # Disable autostash so a user's git configuration cannot hide dirty state.
    envy_rebasing=yes
    if ! git -C "$envy_store" -c rebase.autoStash=false -c rebase.updateRefs=false \
        rebase --quiet FETCH_HEAD > /dev/null 2>&1; then
        if [ -d "$envy_store/.git/rebase-merge" ] || [ -d "$envy_store/.git/rebase-apply" ]; then
            git -C "$envy_store" rebase --abort > /dev/null 2>&1 ||
                envy_error 'could not abort the rebase; the store needs manual recovery'
            envy_sync_failure=conflict
        else
            envy_sync_failure=rebase
        fi
        envy_rebasing=no
        return 1
    fi
    envy_rebasing=no
    envy_after=$(git -C "$envy_store" rev-parse HEAD) || {
        envy_sync_failure=rebase
        return 1
    }
    if [ "$envy_before" != "$envy_after" ]; then
        envy_pull_changed=yes
    fi
}

envy_push_once() {
    # A rebase can merge two independently created project directories without
    # a text conflict while assigning their shared remote to both projects.
    if ! envy_remote_project > /dev/null; then
        envy_sync_failure=remotes
        return 1
    fi
    if envy_push_output=$(git -C "$envy_store" push --porcelain origin HEAD 2> /dev/null); then
        if printf '%s\n' "$envy_push_output" |
            awk -F '\t' '$1 == "=" { found = 1 } END { exit !found }'; then
            envy_push_changed=no
        else
            envy_push_changed=yes
        fi
        return 0
    fi
    envy_sync_failure=push
    return 1
}

envy_push_retry() {
    envy_pull_changed=no
    envy_push_once && return 0
    [ "$envy_sync_failure" != remotes ] || return 1
    envy_fetch_rebase || return 1
    envy_push_once
}

envy_sync_error() {
    case $envy_sync_failure in
        remotes) envy_error 'duplicate project remotes; local commits retained; resolve the duplicate links before retrying envy sync' ;;
        conflict) envy_error 'sync conflict; rebase aborted and local commits retained; reconcile the conflicting changes before retrying' ;;
        identity) envy_error 'sync crosses a rekey; local commits retained; reconcile the divergent store histories before syncing, then run envy unlock' ;;
        offline) envy_error 'remote unavailable; local commits retained; run envy sync when online' ;;
        branch) envy_error 'cannot sync a detached HEAD; check out the store branch first' ;;
        rebase) envy_error 'could not rebase store; local commits retained' ;;
        state) envy_error 'could not record fetch time; check local state directory permissions' ;;
        *) envy_error 'push failed after one retry; local commits retained; run envy sync to retry' ;;
    esac
}

envy_commit_push() {
    envy_git_identity
    git -C "$envy_store" commit --quiet -m "$1" > /dev/null 2>&1 ||
        envy_error 'could not commit store changes'
    if ! envy_push_retry; then
        case $envy_sync_failure in
            offline|push)
                printf '%s\n' 'envy: warning: push failed; local commit retained; run envy sync when the remote is available' >&2
                ;;
            *) envy_sync_error ;;
        esac
    fi
}

envy_report_pull() {
    case $envy_pull_changed in
        yes) printf '%s\n' 'envy: pulled remote changes (rebased local commits)' ;;
        no) printf '%s\n' 'envy: local store already up to date' ;;
    esac
}

envy_report_push() {
    case $envy_push_changed in
        yes) printf '%s\n' 'envy: pushed local commits' ;;
        no) printf '%s\n' 'envy: remote already up to date' ;;
    esac
}

envy_git_no_prompt() {
    # Redirection alone cannot prevent Git/SSH from opening /dev/tty.
    GIT_TERMINAL_PROMPT=0
    GIT_ASKPASS=false
    SSH_ASKPASS=false
    # SSH honours the first BatchMode option, so configured arguments can
    # override the appended option. Force its failing askpass helper too.
    SSH_ASKPASS_REQUIRE=force
    envy_ssh_command=${GIT_SSH_COMMAND-}
    if [ -z "$envy_ssh_command" ]; then
        envy_ssh_command=$(git -C "$envy_store" config core.sshCommand || :)
    fi
    if [ -z "$envy_ssh_command" ]; then
        # GIT_SSH is an executable path, unlike the shell command above.
        envy_ssh_command=$(printf '%s\n' "${GIT_SSH:-ssh}" | LC_ALL=C sed "s/'/'\\\\''/g")
        envy_ssh_command=$(printf "'%s'" "$envy_ssh_command")
    fi
    GIT_SSH_COMMAND="$envy_ssh_command -oBatchMode=yes"
    export GIT_TERMINAL_PROMPT GIT_ASKPASS SSH_ASKPASS SSH_ASKPASS_REQUIRE GIT_SSH_COMMAND
}

envy_sync_command() {
    envy_sync_command_name=$1
    shift
    envy_background=no
    if [ "$envy_sync_command_name" = sync ] && [ "${1-}" = --background ]; then
        shift
        envy_background=yes
        # This internal mode shares the ordinary sync engine and store lock.
        exec < /dev/null > /dev/null 2>&1
    fi
    [ "$#" -eq 0 ] || envy_error "usage: envy $envy_sync_command_name"
    envy_dependencies
    envy_begin
    if [ "$envy_background" = yes ]; then
        envy_settings_load
        # Another queued refresh may have completed while we waited for a write.
        envy_refresh_due || return 0
        envy_git_no_prompt
    fi
    envy_validate_store "$envy_store"
    envy_clean_store
    envy_git_identity
    case $envy_sync_command_name in
        pull|sync)
            envy_fetch_rebase || envy_sync_error
            envy_report_pull
            ;;
    esac
    case $envy_sync_command_name in
        push|sync)
            envy_push_retry || envy_sync_error
            [ "$envy_pull_changed" = no ] || envy_report_pull
            envy_report_push
            ;;
    esac
}

envy_init() {
    [ "$#" -eq 1 ] || envy_error 'usage: envy init <url>'
    envy_dependencies
    envy_begin
    if [ -e "$envy_store" ] || [ -e "$envy_identity" ]; then
        envy_error 'local store or identity already exists'
    fi
    mkdir -p "$envy_data"
    envy_stage=$(mktemp -d "$envy_data/.init.XXXXXX") || envy_error 'cannot create temporary directory'
    git clone --quiet -- "$1" "$envy_stage/store" > /dev/null 2>&1 ||
        envy_error 'could not clone store repository'
    envy_existing_refs=$(git -C "$envy_stage/store" for-each-ref --format='%(refname)' 2> /dev/null) ||
        envy_error 'could not inspect store repository'
    if [ -n "$envy_existing_refs" ]; then
        envy_validate_store "$envy_stage/store"
        envy_recover_identity "$envy_stage/store" "$envy_stage/identity"
        mv "$envy_stage/store" "$envy_store"
        mv "$envy_stage/identity" "$envy_identity"
        envy_git_identity
        envy_record_fetch || envy_error 'could not record fetch time'
        return
    fi
    # age owns the terminal passphrase prompt, including its blank-input generator.
    age-keygen -o "$envy_stage/identity" > /dev/null 2>&1 || envy_error 'could not create identity'
    chmod 600 "$envy_stage/identity"
    age-keygen -y "$envy_stage/identity" > "$envy_stage/store/recipient" 2> /dev/null ||
        envy_error 'could not derive public key'
    age -p -a -o "$envy_stage/store/identity.age" "$envy_stage/identity" ||
        envy_error 'could not protect identity with a passphrase'
    printf '%s\n' 1 > "$envy_stage/store/format"
    git -C "$envy_stage/store" add -- format identity.age recipient
    mv "$envy_stage/store" "$envy_store"
    mv "$envy_stage/identity" "$envy_identity"
    envy_commit_push 'init store'
    envy_record_fetch || envy_error 'could not record fetch time'
}

envy_rekey() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy rekey'
    envy_dependencies
    envy_begin
    envy_validate_store "$envy_store"
    envy_clean_store
    envy_git_identity
    # A cached successful fetch is insufficient: always pull now, under lock.
    envy_fetch_rebase || envy_sync_error
    envy_require_store
    envy_clean_store
    if [ -e "$envy_store/rotation-pending" ] || [ -L "$envy_store/rotation-pending" ]; then
        [ -f "$envy_store/rotation-pending" ] || envy_error 'cannot read pending rotation list'
    fi
    envy_rekey_before=$(git -C "$envy_store" rev-parse HEAD)
    envy_temp=$(mktemp -d "$envy_data/.rekey.XXXXXX") || envy_error 'cannot create temporary directory'
    cp "$envy_identity" "$envy_temp/old-identity"
    age-keygen -o "$envy_temp/identity" > /dev/null 2>&1 || envy_error 'could not create identity'
    chmod 600 "$envy_temp/identity"
    age-keygen -y "$envy_temp/identity" > "$envy_temp/recipient" 2> /dev/null ||
        envy_error 'could not derive public key'
    envy_rekey_tty_state=$( (stty -g < /dev/tty) 2> /dev/null) || envy_rekey_tty_state=
    # A foreground age prompt delays shell traps. wait on an asynchronous
    # child so handled signals can stop it and clean up immediately.
    {
        age -p -a -o "$envy_temp/identity.age" "$envy_temp/identity" <&3 3<&- &
        envy_rekey_age_pid=$!
    } 3<&0
    if wait "$envy_rekey_age_pid"; then
        envy_rekey_age_pid=
    else
        envy_rekey_age_pid=
        envy_error 'could not protect identity with a passphrase'
    fi
    mkdir "$envy_temp/secrets"
    : > "$envy_temp/rotation-pending"
    for envy_file in "$envy_store"/secrets/*.age; do
        [ -f "$envy_file" ] || continue
        envy_secret=${envy_file##*/}
        envy_secret=${envy_secret%.age}
        envy_name "$envy_secret"
        age -d -i "$envy_identity" "$envy_file" > "$envy_temp/value" 2> /dev/null ||
            envy_error "could not decrypt secret: $envy_secret"
        age -a -R "$envy_temp/recipient" -o "$envy_temp/secrets/$envy_secret.age" "$envy_temp/value" 2> /dev/null ||
            envy_error 'could not encrypt secret'
        rm -f "$envy_temp/value"
        printf '%s\n' "$envy_secret" >> "$envy_temp/rotation-pending"
    done
    envy_rekey_had_pending=no
    [ ! -f "$envy_store/rotation-pending" ] || envy_rekey_had_pending=yes
    envy_rekey_restore=yes
    mkdir -p "$envy_store/secrets"
    for envy_file in "$envy_temp"/secrets/*.age; do
        [ -f "$envy_file" ] || continue
        mv "$envy_file" "$envy_store/secrets/"
    done
    mv "$envy_temp/recipient" "$envy_store/recipient"
    mv "$envy_temp/identity.age" "$envy_store/identity.age"
    mv "$envy_temp/rotation-pending" "$envy_store/rotation-pending"
    mv "$envy_temp/identity" "$envy_identity"
    git -C "$envy_store" add -- recipient identity.age rotation-pending secrets
    git -C "$envy_store" commit --quiet -m 'rekey store' > /dev/null 2>&1 ||
        envy_error 'could not commit store changes'
    envy_rekey_restore=no
    printf '%s\n' 'envy: rekeyed store; rotate these secrets at their providers:'
    cat "$envy_store/rotation-pending"
    # Retry ordinary push failures; the sync engine refuses a rebase onto
    # divergent old-key writes and preserves the coherent local commit/key.
    envy_push_retry || envy_error 'rekey push failed; new local identity and commit retained; run envy push to retry, reconciling any divergent remote history first'
}

# Stage bookkeeping before mutating ciphertext, so unreadable metadata fails
# without changing either. Rename preserves a pending mark under its new name.
envy_rotation_prepare() {
    if [ -e "$envy_store/rotation-pending" ] || [ -L "$envy_store/rotation-pending" ]; then
        [ -f "$envy_store/rotation-pending" ] || envy_error 'cannot read pending rotation list'
        LC_ALL=C awk -v name="$1" -v replacement="${2-}" '
            $0 != name { print; next }
            length(replacement) { print replacement }
        ' "$envy_store/rotation-pending" > "$envy_temp/rotation-pending" ||
            envy_error 'cannot read pending rotation list'
    fi
}

envy_rotation_save() {
    if [ -f "$envy_temp/rotation-pending" ] &&
        ! cmp -s "$envy_store/rotation-pending" "$envy_temp/rotation-pending"; then
        mv "$envy_temp/rotation-pending" "$envy_store/rotation-pending"
        git -C "$envy_store" add -- rotation-pending
    fi
}

envy_set() {
    [ "$#" -eq 1 ] || envy_error 'usage: envy set NAME; supply the value through the prompt or stdin'
    envy_name "$1"
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.set.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_rotation_prepare "$1"
    if [ -t 0 ]; then
        envy_tty_state=$(stty -g) || envy_error 'cannot read terminal settings'
        stty -echo || envy_error 'cannot hide terminal input'
        printf 'Secret value: ' >&2
        envy_value=
        if ! IFS= read -r envy_value; then
            envy_error 'could not read secret value'
        fi
        stty "$envy_tty_state"
        envy_tty_state=
        printf '\n' >&2
        printf '%s' "$envy_value" | age -a -R "$envy_store/recipient" -o "$envy_temp/secret.age" 2> /dev/null ||
            envy_error 'could not encrypt secret'
    else
        age -a -R "$envy_store/recipient" -o "$envy_temp/secret.age" 2> /dev/null ||
            envy_error 'could not encrypt secret'
    fi
    mkdir -p "$envy_store/secrets"
    mv "$envy_temp/secret.age" "$envy_store/secrets/$1.age"
    envy_rotation_save
    git -C "$envy_store" add -- "secrets/$1.age"
    envy_commit_push "set $1"
}

envy_get() (
    [ "$#" -eq 1 ] || envy_error 'usage: envy get NAME'
    envy_name "$1"
    envy_require_store
    [ -f "$envy_store/secrets/$1.age" ] || envy_error "secret not found: $1"
    age -d -i "$envy_identity" "$envy_store/secrets/$1.age" 2> /dev/null ||
        envy_error "could not decrypt secret: $1"
)

envy_edit() {
    [ "$#" -eq 1 ] || envy_error 'usage: envy edit NAME'
    envy_name "$1"
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.edit.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_edit_existing=no
    if [ -f "$envy_store/secrets/$1.age" ]; then
        envy_edit_existing=yes
        age -d -i "$envy_identity" "$envy_store/secrets/$1.age" > "$envy_temp/original" 2> /dev/null ||
            envy_error "could not decrypt secret: $1"
    else
        : > "$envy_temp/original"
    fi
    cp "$envy_temp/original" "$envy_temp/value"
    # EDITOR is a user-supplied shell command and may include options. Waiting
    # on an asynchronous child lets signal traps clean up promptly; preserve
    # stdin so terminal editors still receive input.
    {
        sh -c 'exec '"${EDITOR:-vi}"' "$1"' envy-editor "$envy_temp/value" <&3 3<&- &
        envy_editor_pid=$!
    } 3<&0
    if wait "$envy_editor_pid"; then
        envy_editor_pid=
    else
        envy_editor_pid=
        envy_error 'secret editor failed; secret not saved'
    fi
    if [ ! -f "$envy_temp/value" ] || [ -L "$envy_temp/value" ]; then
        envy_error 'editor did not leave a regular file; secret not saved'
    fi
    if [ "$envy_edit_existing" = yes ] && cmp -s "$envy_temp/original" "$envy_temp/value"; then
        return
    fi
    envy_rotation_prepare "$1"
    age -a -R "$envy_store/recipient" -o "$envy_temp/secret.age" "$envy_temp/value" 2> /dev/null ||
        envy_error 'could not encrypt secret'
    mkdir -p "$envy_store/secrets"
    mv "$envy_temp/secret.age" "$envy_store/secrets/$1.age"
    envy_rotation_save
    # Remove plaintext and editor backup files before committing or syncing.
    rm -rf "$envy_temp"
    envy_temp=
    git -C "$envy_store" add -- "secrets/$1.age"
    envy_commit_push "edit $1"
}

envy_ls() (
    [ "$#" -eq 0 ] || envy_error 'usage: envy ls'
    envy_require_store
    for envy_file in "$envy_store"/secrets/*.age; do
        [ -f "$envy_file" ] || continue
        envy_file=${envy_file##*/}
        printf '%s\n' "${envy_file%.age}"
    done
)

# Inspect every central assignment, including ones overridden by later layers.
# The resolver can stage rewritten maps; nothing is published until all validate.
envy_secret_mappings() {
    envy_maps_failed=0
    envy_map_number=0
    for envy_map in "$envy_store/global" "$envy_store"/projects/*/map; do
        [ -e "$envy_map" ] || continue
        envy_map_number=$((envy_map_number + 1))
        if [ ! -f "$envy_map" ]; then
            printf 'envy: %s: mapping is not a regular file\n' "$envy_map" >&2
            envy_maps_failed=1
            continue
        fi
        if [ -n "${envy_resolve_rename_to-}" ]; then
            envy_resolve_rewrite=$envy_temp/maps/$envy_map_number
        fi
        if ! envy_resolve "$envy_map" "$envy_map" > /dev/null; then
            envy_maps_failed=1
        fi
    done
    return "$envy_maps_failed"
}

envy_rm() {
    envy_force=no
    case $# in
        1) ;;
        2)
            case $1:$2 in
                --force:*) envy_force=yes; shift ;;
                *:--force) envy_force=yes; set -- "$1" ;;
                *) envy_error 'usage: envy rm [--force] NAME' ;;
            esac
            ;;
        *) envy_error 'usage: envy rm [--force] NAME' ;;
    esac
    envy_name "$1"
    envy_begin
    envy_require_store
    envy_clean_store
    [ -f "$envy_store/secrets/$1.age" ] || envy_error "secret not found: $1"
    envy_temp=$(mktemp -d "$envy_data/.rm.XXXXXX") || envy_error 'cannot create temporary directory'
    if [ "$envy_force" = no ]; then
        envy_resolve_target=$1
        envy_resolve_locations=$envy_temp/locations
        : > "$envy_resolve_locations"
        envy_secret_mappings || envy_maps_failed=1
        if [ -s "$envy_resolve_locations" ]; then
            printf 'envy: secret %s is referenced by central mappings:\n' "$1" >&2
            cat "$envy_resolve_locations" >&2
            envy_error 'use envy rm --force NAME to remove it anyway'
        fi
        [ "$envy_maps_failed" -eq 0 ] || exit 1
    fi
    envy_rotation_prepare "$1"
    git -C "$envy_store" rm --quiet -- "secrets/$1.age"
    envy_rotation_save
    envy_commit_push "rm $1"
}

envy_mv() {
    [ "$#" -eq 2 ] || envy_error 'usage: envy mv OLD NEW'
    envy_name "$1"
    envy_name "$2"
    envy_begin
    envy_require_store
    envy_clean_store
    [ -f "$envy_store/secrets/$1.age" ] || envy_error "secret not found: $1"
    if [ -e "$envy_store/secrets/$2.age" ] || [ -L "$envy_store/secrets/$2.age" ]; then
        envy_error "secret already exists: $2"
    fi
    envy_temp=$(mktemp -d "$envy_data/.mv.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_rotation_prepare "$1" "$2"
    mkdir "$envy_temp/maps"
    envy_resolve_target=$1
    envy_resolve_rename_to=$2
    envy_secret_mappings || exit 1
    envy_map_number=0
    for envy_map in "$envy_store/global" "$envy_store"/projects/*/map; do
        [ -e "$envy_map" ] || continue
        envy_map_number=$((envy_map_number + 1))
        if [ -f "$envy_temp/maps/$envy_map_number" ]; then
            mv "$envy_temp/maps/$envy_map_number" "$envy_map"
            git -C "$envy_store" add -- "${envy_map#"$envy_store/"}"
        fi
    done
    git -C "$envy_store" mv -- "secrets/$1.age" "secrets/$2.age"
    envy_rotation_save
    printf '%s\n' 'envy: warning: in-project .envy files are not updated; update their references manually' >&2
    envy_commit_push "mv $1 $2"
}

envy_project_name() {
    # Explicit ASCII characters keep validation independent of collation.
    case $1 in
        ''|[!abcdefghijklmnopqrstuvwxyz0123456789]*|*[!abcdefghijklmnopqrstuvwxyz0123456789._-]*)
            envy_error 'invalid project name; use [a-z0-9][a-z0-9._-]*'
            ;;
    esac
}

# Remote URLs are data, never evaluated or passed to a network command here.
envy_normalize_remote() (
    LC_ALL=C awk '
        {
            remote = tolower($0)
            if (sub(/^[a-z][a-z0-9+.-]*:\/\//, "", remote)) {
                slash = index(remote, "/")
                authority = (slash ? substr(remote, 1, slash - 1) : remote)
                path = (slash ? substr(remote, slash) : "")
                sub(/^.*@/, "", authority)
                sub(/:[0-9]+$/, "", authority)
                remote = authority path
            } else {
                # Escape the delimiter inside the class for BSD awk too.
                sub(/^[^\/]*@/, "", remote)
                # A colon before the first slash is SCP syntax.
                colon = index(remote, ":")
                slash = index(remote, "/")
                if (colon && (!slash || colon < slash))
                    remote = substr(remote, 1, colon - 1) "/" substr(remote, colon + 1)
            }
            sub(/\/+$/, "", remote)
            sub(/\.git$/, "", remote)
            print remote
        }
    '
)

# Scan the canonical remote lists, reporting every cross-project duplicate.
# An optional remote selects a project; an empty argument only validates.
envy_remote_project() (
    envy_remote_key=${1-}
    set --
    for envy_remote_file in "$envy_store"/projects/*/remotes; do
        [ -f "$envy_remote_file" ] || continue
        set -- "$@" "$envy_remote_file"
    done
    [ "$#" -gt 0 ] || return 0
    # Push validation also runs without a caller-owned temporary directory.
    envy_remote_temp=$(mktemp -d "$envy_data/.remotes.XXXXXX") || envy_error 'cannot create temporary directory'
    trap 'rm -rf "$envy_remote_temp"' 0
    trap 'exit 1' HUP INT TERM
    : > "$envy_remote_temp/errors"
    if ENVY_REMOTE_KEY=$envy_remote_key ENVY_REMOTE_ERRORS=$envy_remote_temp/errors LC_ALL=C awk '
        $0 != "" {
            project = FILENAME
            sub(/\/remotes$/, "", project)
            sub(/^.*\//, "", project)
            if ($0 in owner && owner[$0] != project) {
                print FILENAME ":" FNR ": duplicate remote; also listed at " location[$0] \
                    " (projects " owner[$0] " and " project ")" > ENVIRON["ENVY_REMOTE_ERRORS"]
                failed = 1
            } else if (!($0 in owner)) {
                owner[$0] = project
                location[$0] = FILENAME ":" FNR
            }
        }
        END {
            if (failed) exit 1
            key = ENVIRON["ENVY_REMOTE_KEY"]
            if (key != "" && key in owner) print owner[key]
        }
    ' "$@"; then
        return 0
    fi
    cat "$envy_remote_temp/errors" >&2
    return 1
)

envy_local_project() (
    [ -e "$envy_state/links" ] || return 0
    [ -f "$envy_state/links" ] || envy_error 'local links path is not a regular file'
    # The last tab separates the project, so spaces and tabs in paths survive.
    ENVY_LINK_ROOT=$1 LC_ALL=C awk '
        {
            path = $0
            sub(/\t[^\t]*$/, "", path)
            if (path == ENVIRON["ENVY_LINK_ROOT"]) {
                project = $0
                sub(/^.*\t/, "", project)
                print project
            }
        }
    ' "$envy_state/links"
)

envy_directory_root() {
    envy_working_directory=$(pwd -P) || envy_error 'cannot resolve working directory'
    envy_is_checkout=no
    if envy_root=$(git rev-parse --show-toplevel 2> /dev/null); then
        envy_is_checkout=yes
        envy_root=$(CDPATH='' cd -- "$envy_root" && pwd -P) || envy_error 'cannot resolve checkout root'
    else
        envy_root=$envy_working_directory
        while :; do
            envy_local_name=$(envy_local_project "$envy_root") || envy_error 'cannot read local links'
            if [ -n "$envy_local_name" ] || [ -e "$envy_root/.envy" ] || [ -L "$envy_root/.envy" ]; then
                break
            fi
            if [ "$envy_root" = / ]; then
                envy_root=$envy_working_directory
                break
            fi
            envy_root=${envy_root%/*}
            envy_root=${envy_root:-/}
        done
    fi
    envy_local_name=$(envy_local_project "$envy_root") || envy_error 'cannot read local links'
    envy_origin=
    if [ "$envy_is_checkout" = yes ]; then
        # Match the stored URL, independent of machine-specific insteadOf rules.
        envy_origin=$(git -C "$envy_root" config --get remote.origin.url 2> /dev/null || :)
    fi
}

envy_directory_project() {
    envy_directory_root
    if [ -n "$envy_local_name" ]; then
        envy_selected_project=$envy_local_name
    elif [ -n "$envy_origin" ]; then
        envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
        envy_selected_project=$(envy_remote_project "$envy_remote") || exit 1
    fi
    if [ -n "$envy_selected_project" ]; then
        envy_project_name "$envy_selected_project"
    fi
}

# Hash and parse the same private snapshot, even if the checkout changes while
# the command runs. Git hashes stdin without applying repository clean filters.
envy_snapshot_project() {
    envy_inproject=${envy_root%/}/.envy
    if [ ! -e "$envy_inproject" ] && [ ! -L "$envy_inproject" ]; then
        envy_inproject=
        return 0
    fi
    if [ ! -f "$envy_inproject" ]; then
        printf 'envy: %s: mapping is not a regular file\n' "$envy_inproject" >&2
        return 1
    fi
    if ! cat "$envy_inproject" > "$envy_temp/in-project"; then
        printf 'envy: %s: cannot read mapping\n' "$envy_inproject" >&2
        return 1
    fi
    envy_inproject_hash=$(git hash-object --stdin < "$envy_temp/in-project") || {
        printf 'envy: %s: cannot hash mapping\n' "$envy_inproject" >&2
        return 1
    }
}

envy_project_approved() (
    [ -e "$envy_state/allowed" ] || return 1
    [ -f "$envy_state/allowed" ] || envy_error 'approval list is not a regular file'
    ENVY_ALLOW_PATH=$envy_inproject ENVY_ALLOW_HASH=$envy_inproject_hash LC_ALL=C awk '
        {
            space = index($0, " ")
            if (space && substr($0, space + 1) == ENVIRON["ENVY_ALLOW_PATH"] &&
                substr($0, 1, space - 1) == ENVIRON["ENVY_ALLOW_HASH"]) approved = 1
        }
        END { exit !approved }
    ' "$envy_state/allowed"
)

envy_allow() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy allow'
    envy_begin
    envy_require_store
    envy_temp=$(mktemp -d "$envy_data/.allow.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_directory_root
    envy_snapshot_project || exit 1
    [ -n "$envy_inproject" ] || envy_error 'no .envy at the current project root'
    case $envy_inproject in
        *'
'*) envy_error 'approval paths cannot contain newlines' ;;
    esac
    envy_resolve_requests=$envy_temp/requests
    : > "$envy_resolve_requests"
    envy_resolve "$envy_temp/in-project" "$envy_inproject" > /dev/null || exit 1
    printf 'envy: %s requests:\n' "$envy_inproject"
    cat "$envy_resolve_requests"
    # Serialize approval updates with the machine lock and replace atomically.
    envy_stage=$(mktemp -d "$envy_state/.allowed.XXXXXX") || envy_error 'cannot create temporary directory'
    : > "$envy_stage/allowed"
    if [ -e "$envy_state/allowed" ] || [ -L "$envy_state/allowed" ]; then
        [ -f "$envy_state/allowed" ] || envy_error 'approval list is not a regular file'
        ENVY_ALLOW_PATH=$envy_inproject LC_ALL=C awk '
            substr($0, index($0, " ") + 1) != ENVIRON["ENVY_ALLOW_PATH"] { print }
        ' "$envy_state/allowed" > "$envy_stage/allowed" || envy_error 'cannot read approval list'
    fi
    printf '%s %s\n' "$envy_inproject_hash" "$envy_inproject" >> "$envy_stage/allowed"
    mv "$envy_stage/allowed" "$envy_state/allowed"
    printf 'envy: approved %s on this machine\n' "$envy_inproject"
}

envy_stage_local_link() {
    # Local links are line records; refuse a newline rather than corrupt them.
    case $envy_root in
        *'
'*) envy_error 'local link paths cannot contain newlines' ;;
    esac
    envy_stage=$(mktemp -d "$envy_state/.links.XXXXXX") || envy_error 'cannot create temporary directory'
    : > "$envy_stage/links"
    if [ -e "$envy_state/links" ]; then
        ENVY_LINK_ROOT=$envy_root LC_ALL=C awk '
            { path = $0; sub(/\t[^\t]*$/, "", path) }
            path != ENVIRON["ENVY_LINK_ROOT"] { print }
        ' "$envy_state/links" > "$envy_stage/links" || envy_error 'cannot read local links'
    fi
    if [ -n "$1" ]; then
        printf '%s\t%s\n' "$envy_root" "$1" >> "$envy_stage/links"
    fi
}

envy_link() {
    envy_link_local=no
    envy_link_name=
    for envy_link_arg do
        case $envy_link_arg in
            --local)
                [ "$envy_link_local" = no ] || envy_error 'usage: envy link [--local] [name]'
                envy_link_local=yes
                ;;
            -*) envy_error 'usage: envy link [--local] [name]' ;;
            *)
                [ -z "$envy_link_name" ] || envy_error 'usage: envy link [--local] [name]'
                envy_project_name "$envy_link_arg"
                envy_link_name=$envy_link_arg
                ;;
        esac
    done
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.link.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_directory_root
    envy_link_name=${envy_link_name:-${envy_root##*/}}
    envy_project_name "$envy_link_name"
    if [ "$envy_link_local" = yes ] || [ -z "$envy_origin" ]; then
        envy_link_local=yes
        # Validate the path before creating any store project.
        case $envy_root in
            *'
'*) envy_error 'local link paths cannot contain newlines' ;;
        esac
    else
        envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
        [ -n "$envy_remote" ] || envy_error 'origin cannot be normalized'
        envy_remote_owner=$(envy_remote_project "$envy_remote") || exit 1
        if [ -n "$envy_remote_owner" ] && [ "$envy_remote_owner" != "$envy_link_name" ]; then
            envy_error "remote already linked to project: $envy_remote_owner"
        fi
    fi
    envy_link_changed=no
    envy_link_path=projects/$envy_link_name
    if [ "$envy_link_local" = yes ]; then
        # Finish fallible reads and staging before changing the store.
        envy_stage_local_link "$envy_link_name"
    fi
    if [ ! -f "$envy_store/$envy_link_path/map" ]; then
        mkdir -p "$envy_store/$envy_link_path"
        : > "$envy_store/$envy_link_path/map"
        envy_link_changed=yes
    fi
    if [ "$envy_link_local" = no ] && [ -z "$envy_remote_owner" ]; then
        printf '%s\n' "$envy_remote" >> "$envy_store/$envy_link_path/remotes"
        envy_link_changed=yes
    fi
    if [ "$envy_link_changed" = yes ]; then
        git -C "$envy_store" add -- "$envy_link_path"
        envy_commit_push "link $envy_link_name"
    fi
    if [ "$envy_link_local" = yes ]; then
        mv "$envy_stage/links" "$envy_state/links"
    fi
}

envy_unlink() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy unlink'
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.link.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_directory_root
    if [ -n "$envy_local_name" ]; then
        envy_stage_local_link ''
        mv "$envy_stage/links" "$envy_state/links"
        return
    fi
    [ -n "$envy_origin" ] || envy_error 'checkout is not linked'
    envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
    envy_remote_owner=$(envy_remote_project "$envy_remote") || exit 1
    [ -n "$envy_remote_owner" ] || envy_error 'checkout is not linked'
    envy_remote_path=projects/$envy_remote_owner/remotes
    ENVY_REMOTE_KEY=$envy_remote LC_ALL=C awk '$0 != ENVIRON["ENVY_REMOTE_KEY"]' \
        "$envy_store/$envy_remote_path" > "$envy_temp/remotes"
    if [ -s "$envy_temp/remotes" ]; then
        mv "$envy_temp/remotes" "$envy_store/$envy_remote_path"
    else
        rm "$envy_store/$envy_remote_path"
    fi
    git -C "$envy_store" add -- "$envy_remote_path"
    envy_commit_push "unlink $envy_remote_owner"
}

# Validate and merge without decrypting. The manifest is a set of file-tested
# secret names; the table is emitted only after every mapping line is valid.
# Arguments are ordered pairs of input path and diagnostic display path.
envy_resolve() (
    : > "$envy_temp/names"
    for envy_file in "$envy_store"/secrets/*.age; do
        [ -f "$envy_file" ] || continue
        envy_file=${envy_file##*/}
        printf '%s\n' "${envy_file%.age}" >> "$envy_temp/names"
    done
    : > "$envy_temp/errors"
    if ENVY_MAP_ERRORS=$envy_temp/errors ENVY_MAP_REFERENCES=${envy_resolve_references-} \
        ENVY_MAP_PROVENANCE=${envy_resolve_provenance-} \
        ENVY_MAP_REQUESTS=${envy_resolve_requests-} ENVY_MAP_TARGET=${envy_resolve_target-} \
        ENVY_MAP_LOCATIONS=${envy_resolve_locations-} ENVY_MAP_RENAME_TO=${envy_resolve_rename_to-} \
        ENVY_MAP_REWRITE=${envy_resolve_rewrite-} LC_ALL=C awk '
        BEGIN {
            for (i = 2; i < ARGC; i += 2) {
                display[ARGV[i]] = ARGV[i + 1]
                delete ARGV[i + 1]
            }
        }
        function error(message, key) {
            # Report only an identifier, never arbitrary mapping text.
            key = "(invalid key)"
            if (match($0, /^[ \t]*[A-Za-z0-9_]+/)) {
                key = substr($0, RSTART, RLENGTH)
                sub(/^[ \t]*/, "", key)
            }
            print display[FILENAME] ":" FNR ": " key ": " message > ENVIRON["ENVY_MAP_ERRORS"]
            failed = 1
        }
        FILENAME == ARGV[1] { secrets[$0] = 1; next }
        ENVIRON["ENVY_MAP_REWRITE"] != "" { lines[++line_count] = $0 }
        $0 == "" || /^#/ { next }
        {
            if ($0 ~ /^[[:space:]]/ || $0 ~ /[[:space:]]$/) {
                error("leading or trailing whitespace is not allowed"); next
            }
            equal = index($0, "=")
            alias = (equal ? substr($0, 1, equal - 1) : $0)
            if (alias !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                error("invalid mapping syntax or alias"); next
            }
            if (alias ~ /^(ENVY_|_ENVY_)/) {
                error("reserved alias"); next
            }
            value = (equal ? substr($0, equal + 1) : alias)
            kind = "secret"
            if (equal && value ~ /^__literal__\("[^"]*"\)$/) {
                kind = "literal"
                value = substr(value, 14, length(value) - 15)
            } else {
                if (value !~ /^[A-Z_][A-Z0-9_]*$/) {
                    error("invalid secret name or mapping syntax"); next
                }
                if (ENVIRON["ENVY_MAP_REFERENCES"] != "")
                    print value >> ENVIRON["ENVY_MAP_REFERENCES"]
                if (!(value in secrets)) {
                    error("secret not found: " value); next
                }
                if (value == ENVIRON["ENVY_MAP_TARGET"]) {
                    if (ENVIRON["ENVY_MAP_LOCATIONS"] != "")
                        print display[FILENAME] ":" FNR ": " alias >> ENVIRON["ENVY_MAP_LOCATIONS"]
                    if (ENVIRON["ENVY_MAP_REWRITE"] != "") {
                        # Bare names keep their original exported alias too.
                        lines[line_count] = alias "=" ENVIRON["ENVY_MAP_RENAME_TO"]
                        rewritten = 1
                    }
                }
            }
            # Include overwritten requests in the review, but never values.
            if (ENVIRON["ENVY_MAP_REQUESTS"] != "")
                print alias "=" (kind == "secret" ? value : "__literal__") >> ENVIRON["ENVY_MAP_REQUESTS"]
            if (!(alias in values)) order[++total] = alias
            values[alias] = value
            kinds[alias] = kind
            sources[alias] = display[FILENAME] ":" FNR
        }
        END {
            if (failed) exit 1
            if (rewritten)
                for (i = 1; i <= line_count; i++)
                    print lines[i] > ENVIRON["ENVY_MAP_REWRITE"]
            for (i = 1; i <= total; i++) {
                if (ENVIRON["ENVY_MAP_PROVENANCE"] == "yes")
                    print "  " order[i] " <- " sources[order[i]] " (" kinds[order[i]] ")"
                else
                    # Sentinels preserve empty values and tabs through shell read.
                    print order[i] "\t" kinds[order[i]] "\t." values[order[i]] "."
            }
        }
    ' "$envy_temp/names" "$@"; then
        return 0
    fi
    cat "$envy_temp/errors" >&2
    return 1
)

envy_project() {
    [ "$#" -ge 1 ] || envy_error 'usage: envy project ls|show|edit|rm [name]'
    envy_project_action=$1
    shift
    case $envy_project_action in
        ls) [ "$#" -eq 0 ] || envy_error 'usage: envy project ls' ;;
        show|edit|rm)
            [ "$#" -eq 1 ] || envy_error "usage: envy project $envy_project_action <name>"
            if [ "$1" != --global ] || [ "$envy_project_action" = rm ]; then
                envy_project_name "$1"
            fi
            ;;
        *) envy_error 'usage: envy project ls|show|edit|rm [name]' ;;
    esac
    case $envy_project_action in
        edit|rm) envy_begin ;;
    esac
    envy_require_store
    if [ "$envy_project_action" != ls ]; then
        case $1 in
            --global) envy_map_path=global ;;
            *) envy_map_path=projects/$1/map ;;
        esac
        envy_map=$envy_store/$envy_map_path
    fi
    case $envy_project_action in
        ls)
            for envy_project_dir in "$envy_store"/projects/*; do
                [ -f "$envy_project_dir/map" ] || continue
                printf '%s\n' "${envy_project_dir##*/}"
            done
            ;;
        show)
            if [ "$1" = --global ] && [ ! -e "$envy_map" ]; then
                return
            fi
            [ -f "$envy_map" ] || envy_error "project not found: $1"
            cat "$envy_map"
            ;;
        edit)
            envy_clean_store
            envy_temp=$(mktemp -d "$envy_data/.project.XXXXXX") || envy_error 'cannot create temporary directory'
            if [ -f "$envy_map" ]; then
                cp "$envy_map" "$envy_temp/map"
            else
                : > "$envy_temp/map"
            fi
            # EDITOR is a user-supplied shell command and may include options.
            sh -c 'exec '"${EDITOR:-vi}"' "$1"' envy-editor "$envy_temp/map" ||
                envy_error 'project editor failed; mapping not saved'
            envy_resolve "$envy_temp/map" "$envy_map" > "$envy_temp/table" || exit 1
            if [ -f "$envy_map" ] && cmp -s "$envy_map" "$envy_temp/map"; then
                return
            fi
            mkdir -p "${envy_map%/*}"
            mv "$envy_temp/map" "$envy_map"
            git -C "$envy_store" add -- "$envy_map_path"
            envy_commit_push "project edit $1"
            ;;
        rm)
            envy_clean_store
            [ -f "$envy_store/projects/$1/map" ] || envy_error "project not found: $1"
            git -C "$envy_store" rm -r --quiet -- "projects/$1"
            envy_commit_push "project rm $1"
            ;;
    esac
}

envy_environment_snapshot() {
    envy_snapshot_project || exit 1
    if [ -n "$envy_inproject" ] && ! envy_project_approved; then
        envy_error "$envy_inproject: unapproved or changed mapping; run envy allow"
    fi
}

envy_environment_table() {
    # Build layers in a subshell so the child command arguments stay intact.
    (
        set --
        if [ -e "$envy_store/global" ]; then
            set -- "$@" "$envy_store/global" "$envy_store/global"
        fi
        if [ -n "$envy_selected_project" ]; then
            envy_map=$envy_store/projects/$envy_selected_project/map
            [ -f "$envy_map" ] || envy_error "project not found: $envy_selected_project"
            set -- "$@" "$envy_map" "$envy_map"
        fi
        if [ -n "$envy_inproject" ]; then
            set -- "$@" "$envy_temp/in-project" "$envy_inproject"
        fi
        envy_resolve "$@"
    ) > "$envy_temp/table" || exit 1
}

envy_environment_exports() {
    : > "$envy_temp/exports"
    while IFS="$(printf '\t')" read -r envy_alias envy_kind envy_value; do
        envy_value=${envy_value#.}
        envy_value=${envy_value%.}
        if [ "$envy_kind" = secret ]; then
            envy_secret=$envy_value
            # Shell variables cannot hold NUL. Validate the decrypted bytes in
            # the private directory before any command substitution can lose them.
            age -d -i "$envy_identity" "$envy_store/secrets/$envy_secret.age" \
                > "$envy_temp/value" 2> /dev/null || envy_error "could not decrypt secret: $envy_secret"
            LC_ALL=C tr -d '\000' < "$envy_temp/value" > "$envy_temp/without-nul" ||
                envy_error "could not inspect secret: $envy_secret"
            cmp -s "$envy_temp/value" "$envy_temp/without-nul" ||
                envy_error "secret contains a NUL byte: $envy_secret; use envy get $envy_secret"
            envy_value=$(
                cat "$envy_temp/value" || exit 1
                printf '.'
            ) || envy_error "could not read secret: $envy_secret"
            rm -f "$envy_temp/value" "$envy_temp/without-nul"
            # A sentinel keeps command substitution from stripping newlines.
            envy_value=${envy_value%.}
        fi
        # Give sed a final newline even for an unterminated value, then remove
        # just that added newline so BSD and GNU sed produce the same result.
        envy_quoted=$(printf '%s\n' "$envy_value" | LC_ALL=C sed "s/'/'\\\\''/g"; printf '.')
        envy_quoted=${envy_quoted%.}
        envy_quoted=${envy_quoted%?}
        if [ "${envy_environment_command-}" = hook ]; then
            # Remove inherited integer/array attributes before assigning text;
            # otherwise the shell can interpret a secret as arithmetic.
            printf 'unset %s || return 1\n' "$envy_alias" >> "$envy_temp/exports"
            printf "export %s='%s' || return 1\n" "$envy_alias" "$envy_quoted" >> "$envy_temp/exports"
        else
            printf "export %s='%s'\n" "$envy_alias" "$envy_quoted" >> "$envy_temp/exports"
        fi
    done < "$envy_temp/table"
}

envy_environment() {
    envy_environment_command=$1
    shift
    envy_selected_project=
    if [ "${1-}" = --project ]; then
        [ "$#" -ge 2 ] || envy_error "usage: envy $envy_environment_command [--project <name>] (run requires -- cmd...)"
        envy_project_name "$2"
        envy_selected_project=$2
        shift 2
    fi
    case $envy_environment_command in
        env) [ "$#" -eq 0 ] || envy_error 'usage: envy env [--project <name>]' ;;
        run)
            if [ "$#" -lt 2 ] || [ "$1" != -- ]; then
                envy_error 'usage: envy run [--project <name>] -- cmd...'
            fi
            shift
            envy_inherited_umask=$(umask)
            ;;
    esac
    envy_prepare
    envy_require_store
    envy_temp=$(mktemp -d "$envy_data/.env.XXXXXX") || envy_error 'cannot create temporary directory'
    if [ -z "$envy_selected_project" ]; then
        envy_directory_project
    else
        envy_directory_root
    fi
    envy_environment_snapshot
    envy_environment_table || exit 1
    envy_environment_exports || exit 1
    case $envy_environment_command in
        env) cat "$envy_temp/exports" ;;
        run)
            envy_exports=$(cat "$envy_temp/exports")
            # Finish cleanup before aliases can replace any script variables.
            envy_cleanup
            trap - 0 HUP INT TERM
            envy_refresh_background || :
            umask "$envy_inherited_umask"
            # Check in a subshell: Bash 3.2 can report success on a fatal
            # assignment in a conditional. Require the completion marker too.
            # The parent reports refusal without borrowing a child's descriptor.
            if [ "$(eval "$envy_exports" 2> /dev/null && printf '%s' ok)" != ok ]; then
                printf '%s\n' 'envy: could not export project environment' >&2
                exit 1
            fi
            eval "$envy_exports" 2> /dev/null
            exec "$@"
            ;;
    esac
}

envy_hook() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy hook'
    cat <<'HOOK'
_envy_unload() {
    _ENVY_UNLOAD_COUNT=0
    _ENVY_LOAD_COUNT=0
    _ENVY_REMAINING=${_ENVY_VARS-}
    while [ -n "$_ENVY_REMAINING" ]; do
        _ENVY_ALIAS=${_ENVY_REMAINING%% *}
        case $_ENVY_REMAINING in
            *' '*) _ENVY_REMAINING=${_ENVY_REMAINING#* } ;;
            *) _ENVY_REMAINING= ;;
        esac
        # The hook runs in the caller's locale; use ASCII characters.
        case $_ENVY_ALIAS in
            ''|[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_]*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*|ENVY_*|_ENVY_*) continue ;;
        esac
        if eval '[ "${_ENVY_SAVED_'"$_ENVY_ALIAS"'+x}" = x ]'; then
            eval 'export '"$_ENVY_ALIAS"'="${_ENVY_SAVED_'"$_ENVY_ALIAS"'}"' 2> /dev/null || :
            unset "_ENVY_SAVED_$_ENVY_ALIAS"
        else
            unset "$_ENVY_ALIAS"
        fi
        _ENVY_UNLOAD_COUNT=$((_ENVY_UNLOAD_COUNT + 1))
    done
    unset _ENVY_VARS
}
_envy_hook() {
    _ENVY_STATUS=$?
    if [ "${_ENVY_PWD-}" != "$PWD" ] ||
        [ "${_ENVY_AMBIENT_OVERRIDE-}" != "${ENVY_AMBIENT-}" ]; then
        _ENVY_PWD=$PWD
        _ENVY_AMBIENT_OVERRIDE=${ENVY_AMBIENT-}
        _ENVY_UNLOAD_COUNT=0
        _ENVY_LOAD_COUNT=0
        if ! _ENVY_CODE=$(ENVY_AMBIENT=${ENVY_AMBIENT-} command envy hook-env); then
            _ENVY_CODE='_envy_unload; unset _ENVY_FP'
        fi
        if ! eval "$_ENVY_CODE" 2> /dev/null; then
            _envy_unload
            unset _ENVY_FP
            printf '%s\n' 'envy: could not export project environment' >&2
        fi
        unset -f _envy_apply 2> /dev/null || :
        if [ "${_ENVY_QUIET-off}" != on ]; then
            if [ "$_ENVY_UNLOAD_COUNT" -gt 0 ]; then
                printf 'envy: unloaded %s vars\n' "$_ENVY_UNLOAD_COUNT" >&2
            fi
            if [ "$_ENVY_LOAD_COUNT" -gt 0 ]; then
                printf 'envy: loaded %s vars\n' "$_ENVY_LOAD_COUNT" >&2
            fi
        fi
        unset _ENVY_CODE
    fi
    return "$_ENVY_STATUS"
}
envy() {
    if command envy "$@"; then _ENVY_COMMAND_STATUS=0; else _ENVY_COMMAND_STATUS=$?; fi
    unset _ENVY_PWD
    return "$_ENVY_COMMAND_STATUS"
}
if [ -z "${_ENVY_HOOK_INSTALLED-}" ]; then
    if [ -n "${ZSH_VERSION-}" ]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook precmd _envy_hook
        _ENVY_HOOK_INSTALLED=1
    elif [ -n "${BASH_VERSION-}" ]; then
        PROMPT_COMMAND="_envy_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
        _ENVY_HOOK_INSTALLED=1
    fi
fi
HOOK
}

# The fingerprint uses metadata only; subdirectory transitions never decrypt.
# Keep emitted code buffered until trust, mappings and every decryption succeed.
envy_hook_resolve() (
    envy_require_store || exit 1
    envy_environment_command=hook
    envy_selected_project=
    envy_directory_project
    envy_environment_snapshot
    envy_environment_table || exit 1
    envy_revision=$(git -C "$envy_store" rev-parse HEAD) || envy_error 'cannot read store revision'
    envy_fingerprint=$(
        printf '%s\n' "$envy_root" "$envy_selected_project" "$envy_revision" "${envy_inproject_hash-}" "$envy_ambient"
        for envy_map in "$envy_store/global" "$envy_store/projects/$envy_selected_project/map"; do
            [ ! -e "$envy_map" ] || git hash-object --stdin < "$envy_map" || exit 1
        done
        # Hash only winning secret references, once each, without decrypting or
        # applying Git clean filters. Same-HEAD ciphertext edits must invalidate
        # the cache just as working-tree mapping edits do.
        LC_ALL=C awk -F '\t' '$2 == "secret" { print substr($3, 2, length($3) - 2) }' \
            "$envy_temp/table" > "$envy_temp/unsorted-references" || exit 1
        LC_ALL=C sort -u "$envy_temp/unsorted-references" > "$envy_temp/references" || exit 1
        while IFS= read -r envy_secret; do
            printf '%s\n' "$envy_secret"
            git hash-object --stdin < "$envy_store/secrets/$envy_secret.age" || exit 1
        done < "$envy_temp/references"
    ) || envy_error 'cannot fingerprint environment files'
    envy_fingerprint=$(printf '%s\n' "$envy_fingerprint" | git hash-object --stdin) ||
        envy_error 'cannot fingerprint environment'
    [ "$envy_fingerprint" != "${_ENVY_FP-}" ] || exit 0
    envy_environment_exports || exit 1
    printf '%s\n' '_envy_unload'
    envy_vars=
    envy_count=0
    while IFS="$(printf '\t')" read -r envy_alias envy_kind envy_value; do
        # Capture originals in the parent shell, where even unexported values
        # are visible. Identifier validation happens in the mapping resolver.
        printf "if [ \"\${%s+x}\" = x ]; then export _ENVY_SAVED_%s=\"\$%s\"; fi\n" \
            "$envy_alias" "$envy_alias" "$envy_alias"
        envy_vars=${envy_vars:+$envy_vars }$envy_alias
        envy_count=$((envy_count + 1))
    done < "$envy_temp/table"
    printf "export _ENVY_VARS='%s'\n" "$envy_vars"
    printf '%s\n' '_envy_apply() {'
    cat "$envy_temp/exports"
    printf "export _ENVY_FP='%s'\n" "$envy_fingerprint"
    printf '_ENVY_LOAD_COUNT=%s\n' "$envy_count"
    printf '%s\n' '}' '_envy_apply'
)

envy_hook_env() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy hook-env'
    envy_prepare
    envy_settings_load
    printf "_ENVY_QUIET='%s'\n" "$envy_quiet"
    case ${ENVY_AMBIENT-} in
        0) envy_ambient=off ;;
        1) envy_ambient=on ;;
        '') ;;
        *)
            # Emit the same safe unload code as mapping errors, preserving quiet.
            printf '%s\n' 'envy: ENVY_AMBIENT must be 0 or 1' >&2
            envy_ambient=off
            ;;
    esac
    if [ "$envy_ambient" = off ]; then
        printf '%s\n' '_envy_unload' 'unset _ENVY_FP'
        envy_refresh_background || :
        return
    fi
    envy_temp=$(mktemp -d "${TMPDIR:-/tmp}/envy-hook.XXXXXX") || envy_error 'cannot create temporary directory'
    if envy_hook_resolve > "$envy_temp/code" 2> "$envy_temp/error"; then
        cat "$envy_temp/code"
    else
        # One diagnostic per failed evaluation, even for many mapping errors.
        LC_ALL=C awk 'NR == 1 { print; exit }' "$envy_temp/error" >&2
        printf '%s\n' '_envy_unload' 'unset _ENVY_FP'
    fi
    envy_refresh_background || :
}

# Inspect each layer separately so a broken file cannot hide the other states.
# The merged provenance is emitted only when every active layer is usable.
envy_status_layer() {
    envy_status_layer_state=absent
    if [ -e "$2" ] || [ -L "$2" ] || [ "$4" = required ]; then
        if [ ! -f "$2" ]; then
            printf 'envy: %s: mapping is not a regular file\n' "$3" >&2
            envy_status_layer_state=invalid
        elif envy_resolve "$2" "$3" > /dev/null; then
            envy_status_layer_state=present
            [ "$4" != unapproved ] || envy_status_layer_state=unapproved
        else
            envy_status_layer_state=invalid
        fi
    fi
    printf 'Layer %s: %s (%s)\n' "$1" "$envy_status_layer_state" "$3"
    case $envy_status_layer_state in
        invalid|unapproved) envy_status_failed=1; envy_status_blocked=yes ;;
    esac
}

envy_status() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy status'
    envy_prepare
    envy_validate_store "$envy_store"
    envy_dependencies
    envy_settings_load
    envy_temp=$(mktemp -d "$envy_data/.status.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_status_failed=0
    envy_status_blocked=no
    envy_selected_project=
    envy_status_match='no project'
    envy_directory_root
    if [ -n "$envy_local_name" ]; then
        envy_selected_project=$envy_local_name
        envy_status_match='local link'
    elif [ -n "$envy_origin" ]; then
        envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
        if envy_selected_project=$(envy_remote_project "$envy_remote"); then
            [ -z "$envy_selected_project" ] || envy_status_match=remote
        else
            envy_status_match=invalid
            envy_status_failed=1
            envy_status_blocked=yes
        fi
    fi
    if [ -n "$envy_selected_project" ] && ! (envy_project_name "$envy_selected_project"); then
        envy_selected_project=
        envy_status_match=invalid
        envy_status_failed=1
        envy_status_blocked=yes
    fi
    envy_status_inproject=${envy_root%/}/.envy
    if [ -z "$envy_selected_project" ] && [ "$envy_status_match" = 'no project' ] &&
        { [ -e "$envy_status_inproject" ] || [ -L "$envy_status_inproject" ]; }; then
        envy_status_match='in-project file only'
    fi
    if [ "$envy_is_checkout" = yes ] || [ "$envy_status_match" != 'no project' ]; then
        printf 'Project root: %s\n' "$envy_root"
    else
        printf '%s\n' 'Project root: none'
    fi
    printf 'Project: %s (match: %s)\n' "${envy_selected_project:-none}" "$envy_status_match"

    envy_status_layer global "$envy_store/global" "$envy_store/global" optional
    if [ -n "$envy_selected_project" ]; then
        envy_map=$envy_store/projects/$envy_selected_project/map
        envy_status_layer 'central project' "$envy_map" "$envy_map" required
    else
        printf '%s\n' 'Layer central project: absent (no matched project)'
    fi
    if envy_snapshot_project; then
        envy_status_trust=optional
        if [ -n "$envy_inproject" ] && ! envy_project_approved; then
            envy_status_trust=unapproved
            printf 'envy: %s: unapproved or changed mapping; run envy allow\n' "$envy_inproject" >&2
        fi
        if [ -n "$envy_inproject" ]; then
            envy_status_layer in-project "$envy_temp/in-project" "$envy_inproject" "$envy_status_trust"
        else
            printf 'Layer in-project: absent (%s)\n' "$envy_status_inproject"
        fi
    else
        printf 'Layer in-project: invalid (%s)\n' "$envy_status_inproject"
        envy_status_failed=1
        envy_status_blocked=yes
    fi
    if [ "$envy_status_blocked" = yes ]; then
        printf '%s\n' 'Aliases: none (layers blocked; nothing can be loaded)'
    else
        # Use the environment resolver itself for the winning file and line.
        # This mode emits identifiers and provenance, never literal/secret values.
        envy_resolve_provenance=yes
        if (envy_environment_table); then
            printf '%s\n' 'Aliases (winning layer file:line):'
            if [ -s "$envy_temp/table" ]; then
                cat "$envy_temp/table"
            else
                printf '%s\n' '  none'
            fi
        else
            printf '%s\n' 'Aliases: none (layers blocked; nothing can be loaded)'
            envy_status_failed=1
        fi
    fi
    envy_status_ambient=$envy_ambient
    case ${ENVY_AMBIENT-} in
        0) envy_status_ambient=off ;;
        1) envy_status_ambient=on ;;
        '') ;;
        *)
            envy_status_ambient=invalid
            printf '%s\n' 'envy: ENVY_AMBIENT must be 0 or 1' >&2
            envy_status_failed=1
            ;;
    esac
    printf 'Ambient: %s (machine: %s)\n' "$envy_status_ambient" "$envy_ambient"
    printf 'Quiet: %s\n' "$envy_quiet"
    # Comparing cached refs never fetches and cannot prompt for authentication.
    if envy_status_counts=$(git -C "$envy_store" rev-list --left-right --count 'HEAD...@{upstream}' 2> /dev/null); then
        printf '%s\n' "$envy_status_counts" | awk '{ printf "Sync (cached upstream): ahead %s, behind %s\n", $1, $2 }'
    else
        printf '%s\n' 'Sync (cached upstream): ahead unknown, behind unknown (no cached upstream)'
    fi
    if [ ! -e "$envy_state/last-fetch" ] && [ ! -L "$envy_state/last-fetch" ]; then
        printf '%s\n' 'Last fetch: never'
    elif [ -f "$envy_state/last-fetch" ] && envy_status_fetched=$(LC_ALL=C awk '
        NR == 1 && /^[0-9]+$/ { fetched = $0; valid = 1; next }
        { valid = 0 }
        END { if (valid) print fetched; else exit 1 }
    ' "$envy_state/last-fetch"); then
        printf 'Last fetch: %s (epoch seconds)\n' "$envy_status_fetched"
    else
        printf '%s\n' 'Last fetch: invalid timestamp'
    fi
    if envy_refresh_due; then
        printf 'Fetch cache: stale (sync interval: %s seconds)\n' "$envy_sync_interval"
    else
        printf 'Fetch cache: fresh (sync interval: %s seconds)\n' "$envy_sync_interval"
    fi
    if envy_check_identity "$envy_store" "$envy_identity" 2> "$envy_temp/identity-error"; then
        printf '%s\n' 'Identity: matches store'
    else
        printf '%s\n' 'Identity: unavailable or does not match store; run envy unlock'
        cat "$envy_temp/identity-error" >&2
        envy_status_failed=1
    fi
    if [ ! -e "$envy_store/rotation-pending" ] && [ ! -L "$envy_store/rotation-pending" ]; then
        printf '%s\n' 'Pending rotation: 0'
    elif [ -f "$envy_store/rotation-pending" ] && envy_status_pending=$(LC_ALL=C awk '
        length($0) { count++ }
        END { print count + 0 }
    ' "$envy_store/rotation-pending"); then
        printf 'Pending rotation: %s\n' "$envy_status_pending"
    else
        printf '%s\n' 'Pending rotation: unknown'
        printf '%s\n' 'envy: cannot read pending rotation list' >&2
        envy_status_failed=1
    fi
    return "$envy_status_failed"
}

# Resolve the executable's physical parent without readlink's platform flags.
# Refuse a final symlink rather than replacing/removing the wrong entry.
envy_script_path() {
    case $0 in
        */*) envy_script=$0 ;;
        *) envy_script=$(command -v "$0") || return 1 ;;
    esac
    case $envy_script in */*) ;; *) envy_script=./$envy_script ;; esac
    envy_script_dir=$(CDPATH='' cd -- "${envy_script%/*}" && pwd -P) ||
        return 1
    envy_script=$envy_script_dir/${envy_script##*/}
    [ -f "$envy_script" ] && [ ! -L "$envy_script" ] ||
        return 1
}

envy_hook_block() (
    LC_ALL=C awk '
        $0 == "# >>> envy >>>" { starts++; start = NR; inside = 1; next }
        $0 == "# <<< envy <<<" { ends++; end = NR; inside = 0; next }
        inside && $0 == "eval \"$(command envy hook)\"" { hook++ }
        inside && $0 == "export PATH" { path++ }
        END {
            if (!starts && !ends) print "absent"
            else if (starts == 1 && ends == 1 && start < end) {
                if (hook == 1 && path == 1) print "present"
                else print "incomplete"
            } else print "invalid"
        }
    ' "$1"
)

envy_doctor_line() {
    if [ "$1" = pass ]; then
        printf 'PASS %s\n' "$2"
    else
        printf 'FAIL %s\n' "$2"
        envy_doctor_failed=1
    fi
}

# ls -n provides portable numeric ownership and symbolic modes on both targets.
# Exact private modes protect local keys/state; public files must not be writable
# by other users. Do not print paths or file contents in a permission diagnostic.
envy_permissions() (
    if [ "$2" = startup ]; then
        envy_file_info=$(LC_ALL=C ls -Lnd "$1" 2> /dev/null) || exit 1
    else
        [ ! -L "$1" ] || exit 1
        envy_file_info=$(LC_ALL=C ls -nd "$1" 2> /dev/null) || exit 1
    fi
    printf '%s\n' "$envy_file_info" | LC_ALL=C awk -v uid="$(id -u)" -v kind="$2" '
        NR == 1 {
            mode = substr($1, 1, 10)
            if ($3 != uid) exit 1
            if (kind == "directory") exit (mode != "drwx------")
            if (kind == "identity") exit (mode != "-rw-------")
            if (substr(mode, 1, 1) != "-" || substr(mode, 2, 1) != "r" ||
                substr(mode, 6, 1) != "-" || substr(mode, 9, 1) != "-") exit 1
            if (kind == "executable" && substr(mode, 4, 1) != "x") exit 1
            exit 0
        }
    '
)

envy_doctor() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy doctor'
    envy_paths
    envy_doctor_failed=0
    for envy_dependency in git age age-keygen; do
        if command -v "$envy_dependency" > /dev/null 2>&1 &&
            envy_dependency_output=$("$envy_dependency" --version 2> /dev/null); then
            # Only print a parsed numeric version, never arbitrary command output.
            envy_dependency_version=$(printf '%s\n' "$envy_dependency_output" | LC_ALL=C awk '
                NR == 1 {
                    sub(/^git version /, ""); sub(/^v/, "")
                    if (match($0, /^[0-9]+(\.[0-9]+)+/)) print substr($0, 1, RLENGTH)
                }
            ')
            if [ -n "$envy_dependency_version" ] &&
                printf '%s\n' "$envy_dependency_version" | awk '{ exit !($0 + 0 >= 1) }'; then
                envy_doctor_line pass "dependency $envy_dependency: $envy_dependency_version"
            else
                envy_doctor_line fail "dependency $envy_dependency: unsupported or unknown version (requires 1.0 or newer)"
            fi
        else
            envy_doctor_line fail "dependency $envy_dependency: missing or cannot report version"
        fi
    done
    if envy_validate_store "$envy_store" > /dev/null 2>&1; then
        envy_doctor_line pass 'store format'
    else
        envy_doctor_line fail 'store format: initialize or update envy'
    fi
    if envy_layout_diagnosis=$(envy_validate_store_layout "$envy_store" 2>&1); then
        envy_doctor_line pass 'store layout'
    else
        envy_doctor_line fail "${envy_layout_diagnosis#envy: }"
    fi
    if envy_check_identity "$envy_store" "$envy_identity" > /dev/null 2>&1; then
        envy_doctor_line pass 'identity matches store'
    else
        envy_doctor_line fail 'identity: missing, invalid or mismatched; run envy unlock'
    fi
    if (envy_clean_store) > /dev/null 2>&1; then
        envy_doctor_line pass 'store cleanliness'
    else
        envy_doctor_line fail 'store cleanliness: dirty, unfinished operation or unavailable'
    fi
    if (
        envy_git_no_prompt
        # Status and ls-remote are read-only; never fetch, unlock or prompt here.
        git -C "$envy_store" ls-remote origin < /dev/null
    ) > /dev/null 2>&1; then
        envy_doctor_line pass 'remote reachable'
    else
        envy_doctor_line fail 'remote reachability: unavailable or authentication required'
    fi
    for envy_shell in bash zsh; do
        envy_rc=$HOME/.${envy_shell}rc
        if command -v "$envy_shell" > /dev/null 2>&1 || [ -e "$envy_rc" ] || [ -L "$envy_rc" ]; then
            if [ -f "$envy_rc" ] &&
                [ "$(envy_hook_block "$envy_rc" 2> /dev/null)" = present ]; then
                envy_doctor_line pass "hook $envy_shell"
            else
                envy_doctor_line fail "hook $envy_shell: missing or damaged startup block; re-run installer"
            fi
            if envy_permissions "$envy_rc" startup; then
                envy_doctor_line pass "permissions $envy_shell startup file"
            else
                envy_doctor_line fail "permissions $envy_shell startup file: require current owner and no group/other write access"
            fi
        fi
    done
    if envy_script_path > /dev/null 2>&1; then
        envy_path_script=$(command -v envy || :)
        envy_path_dir=
        if [ -n "$envy_path_script" ]; then
            case $envy_path_script in */*) ;; *) envy_path_script=./$envy_path_script ;; esac
            envy_path_dir=$(CDPATH='' cd -- "${envy_path_script%/*}" && pwd -P) || :
        fi
        if [ -n "$envy_path_dir" ] &&
            [ "$envy_path_dir/${envy_path_script##*/}" = "$envy_script" ]; then
            envy_doctor_line pass 'PATH resolves this envy executable'
        else
            envy_doctor_line fail 'PATH: add the envy install directory or remove a shadowing executable'
        fi
        if envy_permissions "$envy_script" executable; then
            envy_doctor_line pass 'permissions executable'
        else
            envy_doctor_line fail 'permissions executable: require owner access and no group/other write access'
        fi
    else
        envy_doctor_line fail 'PATH: cannot locate a regular envy executable'
        envy_doctor_line fail 'permissions executable: cannot inspect executable'
    fi
    for envy_permission_kind in identity data store state config settings; do
        envy_permission_optional=no
        envy_permission_mode=directory
        case $envy_permission_kind in
            identity) envy_permission_path=$envy_identity; envy_permission_mode=identity ;;
            data) envy_permission_path=$envy_data ;;
            store) envy_permission_path=$envy_store ;;
            state) envy_permission_path=$envy_state ;;
            config) envy_permission_path=$envy_config_dir; envy_permission_optional=yes ;;
            settings) envy_permission_path=$envy_config_file; envy_permission_mode=identity; envy_permission_optional=yes ;;
        esac
        if [ "$envy_permission_optional" = yes ] &&
            [ ! -e "$envy_permission_path" ] && [ ! -L "$envy_permission_path" ]; then
            envy_doctor_line pass "permissions $envy_permission_kind (not created)"
        elif envy_permissions "$envy_permission_path" "$envy_permission_mode"; then
            envy_doctor_line pass "permissions $envy_permission_kind"
        else
            envy_doctor_line fail "permissions $envy_permission_kind: require current owner, private modes and no symlink"
        fi
    done
    return "$envy_doctor_failed"
}

envy_uninstall_confirm() (
    exec 3<> /dev/tty
    printf 'Delete local identity and store clone? [y/N]: ' >&3
    IFS= read -r envy_answer <&3 || exit 1
    case $envy_answer in y|Y|yes|YES) exit 0 ;; *) exit 1 ;; esac
)

envy_uninstall() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy uninstall'
    envy_script_path || envy_error 'envy executable must be a regular file; invoke its actual path'
    envy_begin
    envy_temp=$(mktemp -d "$envy_script_dir/.envy-uninstall.XXXXXX") ||
        envy_error 'cannot create uninstall temporary directory'
    # Validate and stage both files before removing any startup content.
    for envy_shell in bash zsh; do
        envy_rc=$HOME/.${envy_shell}rc
        if [ -e "$envy_rc" ] || [ -L "$envy_rc" ]; then
            [ -f "$envy_rc" ] || envy_error 'shell startup file is not a regular file'
            envy_block=$(envy_hook_block "$envy_rc") || envy_error 'cannot inspect shell startup file'
            case $envy_block in
                absent) continue ;;
                invalid) envy_error 'damaged envy startup markers; repair them before uninstalling' ;;
            esac
            cp -p "$envy_rc" "$envy_temp/$envy_shell" || envy_error 'cannot stage shell startup file'
            sed '/^# >>> envy >>>$/,/^# <<< envy <<<$/{d;}' "$envy_rc" > "$envy_temp/content" ||
                envy_error 'cannot remove envy startup block'
            cat "$envy_temp/content" > "$envy_temp/$envy_shell" || envy_error 'cannot stage shell startup file'
        fi
    done
    envy_delete_local=no
    if [ -e "$envy_identity" ] || [ -L "$envy_identity" ] ||
        [ -e "$envy_store" ] || [ -L "$envy_store" ]; then
        if envy_uninstall_confirm 2> /dev/null; then envy_delete_local=yes; fi
    fi
    for envy_shell in bash zsh; do
        [ -f "$envy_temp/$envy_shell" ] || continue
        envy_rc=$HOME/.${envy_shell}rc
        if [ -L "$envy_rc" ]; then
            # Preserve dotfile symlinks and their target's ownership/mode.
            cat "$envy_temp/$envy_shell" > "$envy_rc" || envy_error 'cannot save shell startup file'
        else
            mv "$envy_temp/$envy_shell" "$envy_rc" || envy_error 'cannot save shell startup file'
        fi
    done
    rm -f "$envy_script" || envy_error 'cannot remove envy executable'
    if [ "$envy_delete_local" = yes ]; then
        rm -rf "$envy_identity" "$envy_store" || envy_error 'cannot delete local identity and store clone'
        printf '%s\n' 'envy: uninstalled; local identity and store clone deleted; remote store untouched'
    else
        printf '%s\n' 'envy: uninstalled; local identity and store clone retained; remote store untouched'
    fi
}

envy_self_update() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy self-update'
    envy_script_path || envy_error 'envy executable must be a regular file; invoke its actual path'
    envy_prepare
    envy_update_source=${ENVY_UPDATE_SOURCE:-https://github.com/smrdotgg/envy/releases/latest/download/envy}
    envy_temp=$(mktemp -d "$envy_script_dir/.envy-update.XXXXXX") ||
        envy_error 'cannot create update temporary directory'
    if [ -f "$envy_update_source" ]; then
        cp "$envy_update_source" "$envy_temp/envy" || envy_error 'could not copy update source'
    else
        command -v curl > /dev/null 2>&1 ||
            envy_error 'missing dependency: curl; install curl or set ENVY_UPDATE_SOURCE to a local file'
        curl -fsSL "$envy_update_source" -o "$envy_temp/envy" > /dev/null 2>&1 ||
            envy_error 'could not download latest release; current version unchanged'
    fi
    [ -s "$envy_temp/envy" ] || envy_error 'downloaded release is empty; current version unchanged'
    sh -n "$envy_temp/envy" > /dev/null 2>&1 ||
        envy_error 'downloaded release failed syntax validation; current version unchanged'
    # Static sanity check, not authentication. Keep in sync with install.sh.
    # Require core entry points and their dispatcher without running the file.
    envy_new_version=$(LC_ALL=C awk '
        NR == 1 && $0 != "#!/bin/sh" { invalid = 1 }
        /^ENVY_VERSION=[A-Za-z0-9][A-Za-z0-9.+_-]*$/ { version = substr($0, 14); count++ }
        {
            line = $0
            sub(/^[[:space:]]*/, "", line)
            sub(/[[:space:]]*$/, "", line)
            if (line ~ /^envy_(help|init|environment|self_update)\(\)[[:space:]]*[({]$/) {
                name = line
                sub(/\(.*/, "", name)
                functions[name]++
            }
            if ($0 == "case ${1-help} in") dispatcher++
            if (dispatcher) {
                if (line == "envy_environment \"$@\"") environment_call++
                if (line == "envy_self_update \"$@\"") update_call++
                if (line == "help) envy_help ;;") help_call++
            }
            if (line != "") last = line
        }
        END {
            if (invalid || count != 1 || functions["envy_help"] != 1 ||
                functions["envy_init"] != 1 || functions["envy_environment"] != 1 ||
                functions["envy_self_update"] != 1 || dispatcher != 1 ||
                environment_call != 1 || update_call != 1 || help_call != 1 || last != "esac") exit 1
            print version
        }
    ' "$envy_temp/envy") || envy_error 'downloaded release is not an envy script; current version unchanged'
    chmod 755 "$envy_temp/envy" || envy_error 'cannot set update permissions'
    mv "$envy_temp/envy" "$envy_script" || envy_error 'cannot install update; current version unchanged'
    printf 'envy: updated %s -> %s\n' "$ENVY_VERSION" "$envy_new_version"
}

envy_check() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy check'
    envy_prepare
    envy_require_store
    envy_temp=$(mktemp -d "$envy_data/.check.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_resolve_references=$envy_temp/references
    : > "$envy_resolve_references"
    envy_resolve > /dev/null || exit 1
    envy_check_failed=0
    if ! envy_remote_project > /dev/null; then
        envy_check_failed=1
    fi
    for envy_map in "$envy_store/global" "$envy_store"/projects/*/map; do
        [ -e "$envy_map" ] || continue
        if ! envy_resolve "$envy_map" "$envy_map" > /dev/null; then
            envy_check_failed=1
        fi
    done
    envy_directory_root
    # Validation is useful before approval and does not load any environment.
    if envy_snapshot_project; then
        if [ -n "$envy_inproject" ] &&
            ! envy_resolve "$envy_temp/in-project" "$envy_inproject" > /dev/null; then
            envy_check_failed=1
        fi
    else
        envy_check_failed=1
    fi
    # References include overwritten assignments, but exclude literal text.
    LC_ALL=C awk '
        FILENAME == ARGV[1] { referenced[$0] = 1; next }
        !($0 in referenced) { print "envy: unreferenced secret: " $0 }
    ' "$envy_resolve_references" "$envy_temp/names"
    return "$envy_check_failed"
}

case ${1-help} in
    run|env)
        envy_environment "$@"
        ;;
    pull|push|sync)
        envy_sync_command "$@"
        ;;
    init|unlock|rekey|set|get|edit|ls|rm|mv|project|check|link|unlink|allow|config|status|doctor|uninstall)
        envy_command=$1
        shift
        "envy_$envy_command" "$@"
        ;;
    self-update)
        shift
        envy_self_update "$@"
        ;;
    hook)
        shift
        envy_hook "$@"
        ;;
    hook-env)
        shift
        envy_hook_env "$@"
        ;;
    version|help)
        if [ "$#" -gt 1 ]; then
            printf '%s\n' 'envy: unexpected arguments; run envy help' >&2
            exit 1
        fi
        case ${1-help} in
            version) printf 'envy %s\n' "$ENVY_VERSION" ;;
            help) envy_help ;;
        esac
        ;;
    *)
        printf '%s\n' 'envy: unknown command; run envy help' >&2
        exit 1
        ;;
esac
