#!/bin/sh
set -eu

envy_help() (
    printf '%s\n' \
        'Usage: envy <command>' \
        '' \
        'Commands:' \
        '  init <url>    Create or join an encrypted store' \
        '  unlock        Recover the local identity with the store passphrase' \
        '  set NAME      Store a value from a hidden prompt or stdin' \
        '  get NAME      Print a stored value exactly' \
        '  ls            List secret names without decrypting' \
        '  project ls|show|edit|rm  Manage central mappings (show/edit --global)' \
        '  link [--local] [name]  Link this checkout or directory to a project' \
        '  unlink        Remove the current local link, or its origin link' \
        '  allow         Review and approve the current project .envy on this machine' \
        '  run [--project <name>] -- cmd...  Run with the layered environment' \
        '  env [--project <name>]  Print shell exports for the layered environment' \
        '  hook          Print the bash/zsh ambient hook for eval' \
        '  check         Validate store mappings and the current .envy; list unused secrets' \
        '  pull          Fetch and rebase local commits onto the remote' \
        '  push          Push local commits, retrying once after a pull' \
        '  sync          Pull, then push local commits' \
        '  version       Print the envy version' \
        '  help          Show this help' \
        '' \
        'Planned commands (not implemented yet):' \
        '  Secrets:  edit, rm, mv' \
        '  Using:    status' \
        '  Machine:  config, rekey, doctor, self-update, uninstall'
)

envy_error() {
    printf 'envy: %s\n' "$1" >&2
    exit 1
}

envy_paths() {
    envy_data=${XDG_DATA_HOME:-$HOME/.local/share}/envy
    envy_store=$envy_data/store
    envy_identity=$envy_data/identity
    envy_state=${XDG_STATE_HOME:-$HOME/.local/state}/envy
}

envy_cleanup() {
    trap '' HUP INT TERM
    [ -z "$envy_tty_state" ] || stty "$envy_tty_state" 2> /dev/null || :
    [ -z "$envy_temp" ] || rm -rf "$envy_temp"
    [ -z "$envy_stage" ] || rm -rf "$envy_stage"
    if [ "$envy_rebasing" = yes ] &&
        { [ -d "$envy_store/.git/rebase-merge" ] || [ -d "$envy_store/.git/rebase-apply" ]; }; then
        git -C "$envy_store" rebase --abort > /dev/null 2>&1 || :
    fi
    # Only remove our own owner record and an empty lock, never another owner.
    if [ -n "$envy_lock" ]; then
        rmdir "$envy_lock/$$" 2> /dev/null || :
        rmdir "$envy_lock" 2> /dev/null || :
    fi
}

envy_prepare() {
    envy_paths
    umask 077
    envy_tty_state=
    envy_temp=
    envy_stage=
    envy_rebasing=no
    envy_lock=
    trap 'envy_cleanup' 0
    trap 'exit 1' HUP INT TERM
}

envy_begin() {
    envy_prepare
    envy_lock=$envy_state/lock
    mkdir -p "$envy_state"
    envy_lock_started=$(date +%s)
    while :; do
        if mkdir "$envy_lock" 2> /dev/null; then
            # The PID directory is the owner record. Unlike a pid file it can
            # be reclaimed with rmdir, without deleting a replacement owner's
            # record when several processes recover the same stale lock.
            if mkdir "$envy_lock/$$" 2> /dev/null; then
                set -- "$envy_lock"/*
                # An empty lock might have been reclaimed before we published
                # our PID. Proceed only if we are its sole owner.
                if [ "$#" -eq 1 ] && [ "$1" = "$envy_lock/$$" ]; then
                    return
                fi
                rmdir "$envy_lock/$$" 2> /dev/null || :
            fi
        else
            for envy_owner in "$envy_lock"/*; do
                [ -d "$envy_owner" ] || continue
                envy_pid=${envy_owner##*/}
                case $envy_pid in ''|*[!0-9]*|0) continue ;; esac
                if ! kill -0 "$envy_pid" 2> /dev/null; then
                    rmdir "$envy_owner" 2> /dev/null || :
                fi
            done
        fi
        if rmdir "$envy_lock" 2> /dev/null; then
            continue
        fi
        if [ "$(($(date +%s) - envy_lock_started))" -ge 30 ]; then
            envy_error 'store busy; another envy process holds the lock'
        fi
        sleep 1
    done
}

envy_dependencies() {
    for envy_dependency in git age age-keygen; do
        command -v "$envy_dependency" > /dev/null 2>&1 ||
            envy_error "missing dependency: $envy_dependency"
    done
}

envy_name() {
    case $1 in
        ''|[!A-Z_]*|*[!A-Z0-9_]*) envy_error 'invalid secret name; use [A-Z_][A-Z0-9_]*' ;;
    esac
}

envy_validate_store() (
    if [ ! -d "$1/.git" ] || [ ! -f "$1/format" ]; then
        envy_error 'store not initialized; run envy init <url>'
    fi
    envy_format=$(cat "$1/format")
    case $envy_format in
        1) ;;
        ''|*[!0-9]*) envy_error 'unsupported store format' ;;
        *)
            # awk handles large version numbers without shell integer overflow.
            if printf '%s\n' "$envy_format" | awk '{ exit !($0 + 0 > 1) }'; then
                envy_error 'unsupported store format; update envy to read this newer store'
            fi
            envy_error 'unsupported store format'
            ;;
    esac
)

envy_check_identity() (
    [ -f "$2" ] || envy_error 'local identity missing; run envy unlock'
    envy_public=$(age-keygen -y "$2" 2> /dev/null) ||
        envy_error 'cannot read local identity; run envy unlock'
    if [ ! -f "$1/recipient" ] ||
        [ "$envy_public" != "$(cat "$1/recipient")" ]; then
        envy_error 'store public key does not match local identity; run envy unlock'
    fi
)

envy_require_store() {
    envy_paths
    envy_validate_store "$envy_store" || return 1
    envy_dependencies || return 1
    envy_check_identity "$envy_store" "$envy_identity"
}

envy_recover_identity() {
    [ -f "$1/identity.age" ] || envy_error 'store encrypted identity missing'
    # age reads the passphrase from the terminal, never stdin or an argument.
    age -d -o "$2" "$1/identity.age" 2> /dev/null ||
        envy_error 'could not unlock identity; check the store passphrase'
    chmod 600 "$2"
    envy_check_identity "$1" "$2"
}

envy_unlock() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy unlock'
    envy_dependencies
    envy_begin
    envy_validate_store "$envy_store"
    [ ! -d "$envy_identity" ] ||
        envy_error 'local identity path is a directory; move it aside and run envy unlock'
    envy_stage=$(mktemp -d "$envy_data/.unlock.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_recover_identity "$envy_store" "$envy_stage/identity"
    mv "$envy_stage/identity" "$envy_identity"
}

envy_git_identity() {
    if [ -z "$(git -C "$envy_store" config user.name || :)" ]; then
        git -C "$envy_store" config user.name envy
    fi
    if [ -z "$(git -C "$envy_store" config user.email || :)" ]; then
        git -C "$envy_store" config user.email envy@localhost
    fi
}

envy_clean_store() {
    # Check untracked files even when the user's status display hides them.
    envy_store_status=$(git -C "$envy_store" status --porcelain --untracked-files=all 2> /dev/null) ||
        envy_error 'could not inspect store cleanliness; resolve the repository error before writing or syncing'
    if [ -n "$envy_store_status" ] ||
        [ -d "$envy_store/.git/rebase-merge" ] ||
        [ -d "$envy_store/.git/rebase-apply" ] ||
        [ -f "$envy_store/.git/MERGE_HEAD" ]; then
        envy_error 'store has uncommitted changes or an unfinished operation; resolve them before writing or syncing'
    fi
}

envy_fetch_rebase() {
    envy_sync_failure=
    envy_pull_changed=no
    envy_branch=$(git -C "$envy_store" symbolic-ref --quiet --short HEAD) || {
        envy_sync_failure=branch
        return 1
    }
    if ! git -C "$envy_store" fetch --quiet origin "$envy_branch" > /dev/null 2>&1; then
        envy_sync_failure=offline
        return 1
    fi
    date +%s > "$envy_state/last-fetch" || {
        envy_sync_failure=state
        return 1
    }
    envy_before=$(git -C "$envy_store" rev-parse HEAD) || {
        envy_sync_failure=rebase
        return 1
    }
    # Disable autostash so a user's git configuration cannot hide dirty state.
    envy_rebasing=yes
    if ! git -C "$envy_store" -c rebase.autoStash=false -c rebase.updateRefs=false \
        rebase --quiet FETCH_HEAD > /dev/null 2>&1; then
        if [ -d "$envy_store/.git/rebase-merge" ] || [ -d "$envy_store/.git/rebase-apply" ]; then
            git -C "$envy_store" rebase --abort > /dev/null 2>&1 ||
                envy_error 'could not abort the rebase; the store needs manual recovery'
            envy_sync_failure=conflict
        else
            envy_sync_failure=rebase
        fi
        envy_rebasing=no
        return 1
    fi
    envy_rebasing=no
    envy_after=$(git -C "$envy_store" rev-parse HEAD) || {
        envy_sync_failure=rebase
        return 1
    }
    if [ "$envy_before" != "$envy_after" ]; then
        envy_pull_changed=yes
    fi
}

envy_push_once() {
    # A rebase can merge two independently created project directories without
    # a text conflict while assigning their shared remote to both projects.
    if ! envy_remote_project > /dev/null; then
        envy_sync_failure=remotes
        return 1
    fi
    if envy_push_output=$(git -C "$envy_store" push --porcelain origin HEAD 2> /dev/null); then
        if printf '%s\n' "$envy_push_output" |
            awk -F '\t' '$1 == "=" { found = 1 } END { exit !found }'; then
            envy_push_changed=no
        else
            envy_push_changed=yes
        fi
        return 0
    fi
    envy_sync_failure=push
    return 1
}

envy_push_retry() {
    envy_pull_changed=no
    envy_push_once && return 0
    [ "$envy_sync_failure" != remotes ] || return 1
    envy_fetch_rebase || return 1
    envy_push_once
}

envy_sync_error() {
    case $envy_sync_failure in
        remotes) envy_error 'duplicate project remotes; local commits retained; resolve the duplicate links before retrying envy sync' ;;
        conflict) envy_error 'sync conflict; rebase aborted and local commits retained; reconcile the conflicting changes before retrying' ;;
        offline) envy_error 'remote unavailable; local commits retained; run envy sync when online' ;;
        branch) envy_error 'cannot sync a detached HEAD; check out the store branch first' ;;
        rebase) envy_error 'could not rebase store; local commits retained' ;;
        state) envy_error 'could not record fetch time; check local state directory permissions' ;;
        *) envy_error 'push failed after one retry; local commits retained; run envy sync to retry' ;;
    esac
}

envy_commit_push() {
    envy_git_identity
    git -C "$envy_store" commit --quiet -m "$1" > /dev/null 2>&1 ||
        envy_error 'could not commit store changes'
    if ! envy_push_retry; then
        case $envy_sync_failure in
            offline|push)
                printf '%s\n' 'envy: warning: push failed; local commit retained; run envy sync when the remote is available' >&2
                ;;
            *) envy_sync_error ;;
        esac
    fi
}

envy_report_pull() {
    case $envy_pull_changed in
        yes) printf '%s\n' 'envy: pulled remote changes (rebased local commits)' ;;
        no) printf '%s\n' 'envy: local store already up to date' ;;
    esac
}

envy_report_push() {
    case $envy_push_changed in
        yes) printf '%s\n' 'envy: pushed local commits' ;;
        no) printf '%s\n' 'envy: remote already up to date' ;;
    esac
}

envy_sync_command() {
    envy_sync_command_name=$1
    shift
    [ "$#" -eq 0 ] || envy_error "usage: envy $envy_sync_command_name"
    envy_dependencies
    envy_begin
    envy_validate_store "$envy_store"
    envy_clean_store
    envy_git_identity
    case $envy_sync_command_name in
        pull|sync)
            envy_fetch_rebase || envy_sync_error
            envy_report_pull
            ;;
    esac
    case $envy_sync_command_name in
        push|sync)
            envy_push_retry || envy_sync_error
            [ "$envy_pull_changed" = no ] || envy_report_pull
            envy_report_push
            ;;
    esac
}

envy_init() {
    [ "$#" -eq 1 ] || envy_error 'usage: envy init <url>'
    envy_dependencies
    envy_begin
    if [ -e "$envy_store" ] || [ -e "$envy_identity" ]; then
        envy_error 'local store or identity already exists'
    fi
    mkdir -p "$envy_data"
    envy_stage=$(mktemp -d "$envy_data/.init.XXXXXX") || envy_error 'cannot create temporary directory'
    git clone --quiet -- "$1" "$envy_stage/store" > /dev/null 2>&1 ||
        envy_error 'could not clone store repository'
    envy_existing_refs=$(git -C "$envy_stage/store" for-each-ref --format='%(refname)' 2> /dev/null) ||
        envy_error 'could not inspect store repository'
    if [ -n "$envy_existing_refs" ]; then
        envy_validate_store "$envy_stage/store"
        envy_recover_identity "$envy_stage/store" "$envy_stage/identity"
        mv "$envy_stage/store" "$envy_store"
        mv "$envy_stage/identity" "$envy_identity"
        envy_git_identity
        return
    fi
    # age owns the terminal passphrase prompt, including its blank-input generator.
    age-keygen -o "$envy_stage/identity" > /dev/null 2>&1 || envy_error 'could not create identity'
    chmod 600 "$envy_stage/identity"
    age-keygen -y "$envy_stage/identity" > "$envy_stage/store/recipient" 2> /dev/null ||
        envy_error 'could not derive public key'
    age -p -a -o "$envy_stage/store/identity.age" "$envy_stage/identity" ||
        envy_error 'could not protect identity with a passphrase'
    printf '%s\n' 1 > "$envy_stage/store/format"
    git -C "$envy_stage/store" add -- format identity.age recipient
    mv "$envy_stage/store" "$envy_store"
    mv "$envy_stage/identity" "$envy_identity"
    envy_commit_push 'init store'
}

envy_set() {
    [ "$#" -eq 1 ] || envy_error 'usage: envy set NAME; supply the value through the prompt or stdin'
    envy_name "$1"
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.set.XXXXXX") || envy_error 'cannot create temporary directory'
    if [ -t 0 ]; then
        envy_tty_state=$(stty -g) || envy_error 'cannot read terminal settings'
        stty -echo || envy_error 'cannot hide terminal input'
        printf 'Secret value: ' >&2
        envy_value=
        if ! IFS= read -r envy_value; then
            envy_error 'could not read secret value'
        fi
        stty "$envy_tty_state"
        envy_tty_state=
        printf '\n' >&2
        printf '%s' "$envy_value" | age -a -R "$envy_store/recipient" -o "$envy_temp/secret.age" 2> /dev/null ||
            envy_error 'could not encrypt secret'
    else
        age -a -R "$envy_store/recipient" -o "$envy_temp/secret.age" 2> /dev/null ||
            envy_error 'could not encrypt secret'
    fi
    mkdir -p "$envy_store/secrets"
    mv "$envy_temp/secret.age" "$envy_store/secrets/$1.age"
    git -C "$envy_store" add -- "secrets/$1.age"
    envy_commit_push "set $1"
}

envy_get() (
    [ "$#" -eq 1 ] || envy_error 'usage: envy get NAME'
    envy_name "$1"
    envy_require_store
    [ -f "$envy_store/secrets/$1.age" ] || envy_error "secret not found: $1"
    age -d -i "$envy_identity" "$envy_store/secrets/$1.age" 2> /dev/null ||
        envy_error "could not decrypt secret: $1"
)

envy_ls() (
    [ "$#" -eq 0 ] || envy_error 'usage: envy ls'
    envy_require_store
    for envy_file in "$envy_store"/secrets/*.age; do
        [ -f "$envy_file" ] || continue
        envy_file=${envy_file##*/}
        printf '%s\n' "${envy_file%.age}"
    done
)

envy_project_name() {
    case $1 in
        ''|[!a-z0-9]*|*[!a-z0-9._-]*)
            envy_error 'invalid project name; use [a-z0-9][a-z0-9._-]*'
            ;;
    esac
}

# Remote URLs are data, never evaluated or passed to a network command here.
envy_normalize_remote() (
    LC_ALL=C awk '
        {
            remote = tolower($0)
            if (sub(/^[a-z][a-z0-9+.-]*:\/\//, "", remote)) {
                slash = index(remote, "/")
                authority = (slash ? substr(remote, 1, slash - 1) : remote)
                path = (slash ? substr(remote, slash) : "")
                sub(/^.*@/, "", authority)
                sub(/:[0-9]+$/, "", authority)
                remote = authority path
            } else {
                sub(/^[^/]*@/, "", remote)
                # A colon before the first slash is SCP syntax.
                colon = index(remote, ":")
                slash = index(remote, "/")
                if (colon && (!slash || colon < slash))
                    remote = substr(remote, 1, colon - 1) "/" substr(remote, colon + 1)
            }
            sub(/\/+$/, "", remote)
            sub(/\.git$/, "", remote)
            print remote
        }
    '
)

# Scan the canonical remote lists, reporting every cross-project duplicate.
# An optional remote selects a project; an empty argument only validates.
envy_remote_project() (
    envy_remote_key=${1-}
    set --
    for envy_remote_file in "$envy_store"/projects/*/remotes; do
        [ -f "$envy_remote_file" ] || continue
        set -- "$@" "$envy_remote_file"
    done
    [ "$#" -gt 0 ] || return 0
    # Push validation also runs without a caller-owned temporary directory.
    envy_remote_temp=$(mktemp -d "$envy_data/.remotes.XXXXXX") || envy_error 'cannot create temporary directory'
    trap 'rm -rf "$envy_remote_temp"' 0
    trap 'exit 1' HUP INT TERM
    : > "$envy_remote_temp/errors"
    if ENVY_REMOTE_KEY=$envy_remote_key ENVY_REMOTE_ERRORS=$envy_remote_temp/errors LC_ALL=C awk '
        $0 != "" {
            project = FILENAME
            sub(/\/remotes$/, "", project)
            sub(/^.*\//, "", project)
            if ($0 in owner && owner[$0] != project) {
                print FILENAME ":" FNR ": duplicate remote; also listed at " location[$0] \
                    " (projects " owner[$0] " and " project ")" > ENVIRON["ENVY_REMOTE_ERRORS"]
                failed = 1
            } else if (!($0 in owner)) {
                owner[$0] = project
                location[$0] = FILENAME ":" FNR
            }
        }
        END {
            if (failed) exit 1
            key = ENVIRON["ENVY_REMOTE_KEY"]
            if (key != "" && key in owner) print owner[key]
        }
    ' "$@"; then
        return 0
    fi
    cat "$envy_remote_temp/errors" >&2
    return 1
)

envy_local_project() (
    [ -e "$envy_state/links" ] || return 0
    [ -f "$envy_state/links" ] || envy_error 'local links path is not a regular file'
    # The last tab separates the project, so spaces and tabs in paths survive.
    ENVY_LINK_ROOT=$1 LC_ALL=C awk '
        {
            path = $0
            sub(/\t[^\t]*$/, "", path)
            if (path == ENVIRON["ENVY_LINK_ROOT"]) {
                project = $0
                sub(/^.*\t/, "", project)
                print project
            }
        }
    ' "$envy_state/links"
)

envy_directory_root() {
    envy_working_directory=$(pwd -P) || envy_error 'cannot resolve working directory'
    envy_is_checkout=no
    if envy_root=$(git rev-parse --show-toplevel 2> /dev/null); then
        envy_is_checkout=yes
        envy_root=$(CDPATH='' cd -- "$envy_root" && pwd -P) || envy_error 'cannot resolve checkout root'
    else
        envy_root=$envy_working_directory
        while :; do
            envy_local_name=$(envy_local_project "$envy_root") || envy_error 'cannot read local links'
            if [ -n "$envy_local_name" ] || [ -e "$envy_root/.envy" ] || [ -L "$envy_root/.envy" ]; then
                break
            fi
            if [ "$envy_root" = / ]; then
                envy_root=$envy_working_directory
                break
            fi
            envy_root=${envy_root%/*}
            envy_root=${envy_root:-/}
        done
    fi
    envy_local_name=$(envy_local_project "$envy_root") || envy_error 'cannot read local links'
    envy_origin=
    if [ "$envy_is_checkout" = yes ]; then
        # Match the stored URL, independent of machine-specific insteadOf rules.
        envy_origin=$(git -C "$envy_root" config --get remote.origin.url 2> /dev/null || :)
    fi
}

envy_directory_project() {
    envy_directory_root
    if [ -n "$envy_local_name" ]; then
        envy_selected_project=$envy_local_name
    elif [ -n "$envy_origin" ]; then
        envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
        envy_selected_project=$(envy_remote_project "$envy_remote") || exit 1
    fi
    if [ -n "$envy_selected_project" ]; then
        envy_project_name "$envy_selected_project"
    fi
}

# Hash and parse the same private snapshot, even if the checkout changes while
# the command runs. Git hashes stdin without applying repository clean filters.
envy_snapshot_project() {
    envy_inproject=${envy_root%/}/.envy
    if [ ! -e "$envy_inproject" ] && [ ! -L "$envy_inproject" ]; then
        envy_inproject=
        return 0
    fi
    if [ ! -f "$envy_inproject" ]; then
        printf 'envy: %s: mapping is not a regular file\n' "$envy_inproject" >&2
        return 1
    fi
    if ! cat "$envy_inproject" > "$envy_temp/in-project"; then
        printf 'envy: %s: cannot read mapping\n' "$envy_inproject" >&2
        return 1
    fi
    envy_inproject_hash=$(git hash-object --stdin < "$envy_temp/in-project") || {
        printf 'envy: %s: cannot hash mapping\n' "$envy_inproject" >&2
        return 1
    }
}

envy_project_approved() (
    [ -e "$envy_state/allowed" ] || return 1
    [ -f "$envy_state/allowed" ] || envy_error 'approval list is not a regular file'
    ENVY_ALLOW_PATH=$envy_inproject ENVY_ALLOW_HASH=$envy_inproject_hash LC_ALL=C awk '
        {
            space = index($0, " ")
            if (space && substr($0, space + 1) == ENVIRON["ENVY_ALLOW_PATH"] &&
                substr($0, 1, space - 1) == ENVIRON["ENVY_ALLOW_HASH"]) approved = 1
        }
        END { exit !approved }
    ' "$envy_state/allowed"
)

envy_allow() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy allow'
    envy_begin
    envy_require_store
    envy_temp=$(mktemp -d "$envy_data/.allow.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_directory_root
    envy_snapshot_project || exit 1
    [ -n "$envy_inproject" ] || envy_error 'no .envy at the current project root'
    case $envy_inproject in
        *'
'*) envy_error 'approval paths cannot contain newlines' ;;
    esac
    envy_resolve_requests=$envy_temp/requests
    : > "$envy_resolve_requests"
    envy_resolve "$envy_temp/in-project" "$envy_inproject" > /dev/null || exit 1
    printf 'envy: %s requests:\n' "$envy_inproject"
    cat "$envy_resolve_requests"
    # Serialize approval updates with the machine lock and replace atomically.
    envy_stage=$(mktemp -d "$envy_state/.allowed.XXXXXX") || envy_error 'cannot create temporary directory'
    : > "$envy_stage/allowed"
    if [ -e "$envy_state/allowed" ] || [ -L "$envy_state/allowed" ]; then
        [ -f "$envy_state/allowed" ] || envy_error 'approval list is not a regular file'
        ENVY_ALLOW_PATH=$envy_inproject LC_ALL=C awk '
            substr($0, index($0, " ") + 1) != ENVIRON["ENVY_ALLOW_PATH"] { print }
        ' "$envy_state/allowed" > "$envy_stage/allowed" || envy_error 'cannot read approval list'
    fi
    printf '%s %s\n' "$envy_inproject_hash" "$envy_inproject" >> "$envy_stage/allowed"
    mv "$envy_stage/allowed" "$envy_state/allowed"
    printf 'envy: approved %s on this machine\n' "$envy_inproject"
}

envy_stage_local_link() {
    # Local links are line records; refuse a newline rather than corrupt them.
    case $envy_root in
        *'
'*) envy_error 'local link paths cannot contain newlines' ;;
    esac
    envy_stage=$(mktemp -d "$envy_state/.links.XXXXXX") || envy_error 'cannot create temporary directory'
    : > "$envy_stage/links"
    if [ -e "$envy_state/links" ]; then
        ENVY_LINK_ROOT=$envy_root LC_ALL=C awk '
            { path = $0; sub(/\t[^\t]*$/, "", path) }
            path != ENVIRON["ENVY_LINK_ROOT"] { print }
        ' "$envy_state/links" > "$envy_stage/links" || envy_error 'cannot read local links'
    fi
    if [ -n "$1" ]; then
        printf '%s\t%s\n' "$envy_root" "$1" >> "$envy_stage/links"
    fi
}

envy_link() {
    envy_link_local=no
    envy_link_name=
    for envy_link_arg do
        case $envy_link_arg in
            --local)
                [ "$envy_link_local" = no ] || envy_error 'usage: envy link [--local] [name]'
                envy_link_local=yes
                ;;
            -*) envy_error 'usage: envy link [--local] [name]' ;;
            *)
                [ -z "$envy_link_name" ] || envy_error 'usage: envy link [--local] [name]'
                envy_project_name "$envy_link_arg"
                envy_link_name=$envy_link_arg
                ;;
        esac
    done
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.link.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_directory_root
    envy_link_name=${envy_link_name:-${envy_root##*/}}
    envy_project_name "$envy_link_name"
    if [ "$envy_link_local" = yes ] || [ -z "$envy_origin" ]; then
        envy_link_local=yes
        # Validate the path before creating any store project.
        case $envy_root in
            *'
'*) envy_error 'local link paths cannot contain newlines' ;;
        esac
    else
        envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
        [ -n "$envy_remote" ] || envy_error 'origin cannot be normalized'
        envy_remote_owner=$(envy_remote_project "$envy_remote") || exit 1
        if [ -n "$envy_remote_owner" ] && [ "$envy_remote_owner" != "$envy_link_name" ]; then
            envy_error "remote already linked to project: $envy_remote_owner"
        fi
    fi
    envy_link_changed=no
    envy_link_path=projects/$envy_link_name
    if [ "$envy_link_local" = yes ]; then
        # Finish fallible reads and staging before changing the store.
        envy_stage_local_link "$envy_link_name"
    fi
    if [ ! -f "$envy_store/$envy_link_path/map" ]; then
        mkdir -p "$envy_store/$envy_link_path"
        : > "$envy_store/$envy_link_path/map"
        envy_link_changed=yes
    fi
    if [ "$envy_link_local" = no ] && [ -z "$envy_remote_owner" ]; then
        printf '%s\n' "$envy_remote" >> "$envy_store/$envy_link_path/remotes"
        envy_link_changed=yes
    fi
    if [ "$envy_link_changed" = yes ]; then
        git -C "$envy_store" add -- "$envy_link_path"
        envy_commit_push "link $envy_link_name"
    fi
    if [ "$envy_link_local" = yes ]; then
        mv "$envy_stage/links" "$envy_state/links"
    fi
}

envy_unlink() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy unlink'
    envy_begin
    envy_require_store
    envy_clean_store
    envy_temp=$(mktemp -d "$envy_data/.link.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_directory_root
    if [ -n "$envy_local_name" ]; then
        envy_stage_local_link ''
        mv "$envy_stage/links" "$envy_state/links"
        return
    fi
    [ -n "$envy_origin" ] || envy_error 'checkout is not linked'
    envy_remote=$(printf '%s\n' "$envy_origin" | envy_normalize_remote)
    envy_remote_owner=$(envy_remote_project "$envy_remote") || exit 1
    [ -n "$envy_remote_owner" ] || envy_error 'checkout is not linked'
    envy_remote_path=projects/$envy_remote_owner/remotes
    ENVY_REMOTE_KEY=$envy_remote LC_ALL=C awk '$0 != ENVIRON["ENVY_REMOTE_KEY"]' \
        "$envy_store/$envy_remote_path" > "$envy_temp/remotes"
    if [ -s "$envy_temp/remotes" ]; then
        mv "$envy_temp/remotes" "$envy_store/$envy_remote_path"
    else
        rm "$envy_store/$envy_remote_path"
    fi
    git -C "$envy_store" add -- "$envy_remote_path"
    envy_commit_push "unlink $envy_remote_owner"
}

# Validate and merge without decrypting. The manifest is a set of file-tested
# secret names; the table is emitted only after every mapping line is valid.
# Arguments are ordered pairs of input path and diagnostic display path.
envy_resolve() (
    : > "$envy_temp/names"
    for envy_file in "$envy_store"/secrets/*.age; do
        [ -f "$envy_file" ] || continue
        envy_file=${envy_file##*/}
        printf '%s\n' "${envy_file%.age}" >> "$envy_temp/names"
    done
    : > "$envy_temp/errors"
    if ENVY_MAP_ERRORS=$envy_temp/errors ENVY_MAP_REFERENCES=${envy_resolve_references-} \
        ENVY_MAP_REQUESTS=${envy_resolve_requests-} LC_ALL=C awk '
        BEGIN {
            for (i = 2; i < ARGC; i += 2) {
                display[ARGV[i]] = ARGV[i + 1]
                delete ARGV[i + 1]
            }
        }
        function error(message, key) {
            # Report only an identifier, never arbitrary mapping text.
            key = "(invalid key)"
            if (match($0, /^[ \t]*[A-Za-z0-9_]+/)) {
                key = substr($0, RSTART, RLENGTH)
                sub(/^[ \t]*/, "", key)
            }
            print display[FILENAME] ":" FNR ": " key ": " message > ENVIRON["ENVY_MAP_ERRORS"]
            failed = 1
        }
        FILENAME == ARGV[1] { secrets[$0] = 1; next }
        $0 == "" || /^#/ { next }
        {
            if ($0 ~ /^[[:space:]]/ || $0 ~ /[[:space:]]$/) {
                error("leading or trailing whitespace is not allowed"); next
            }
            equal = index($0, "=")
            alias = (equal ? substr($0, 1, equal - 1) : $0)
            if (alias !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                error("invalid mapping syntax or alias"); next
            }
            if (alias ~ /^(ENVY_|_ENVY_)/) {
                error("reserved alias"); next
            }
            value = (equal ? substr($0, equal + 1) : alias)
            kind = "secret"
            if (equal && value ~ /^__literal__\("[^"]*"\)$/) {
                kind = "literal"
                value = substr(value, 14, length(value) - 15)
            } else {
                if (value !~ /^[A-Z_][A-Z0-9_]*$/) {
                    error("invalid secret name or mapping syntax"); next
                }
                if (ENVIRON["ENVY_MAP_REFERENCES"] != "")
                    print value >> ENVIRON["ENVY_MAP_REFERENCES"]
                if (!(value in secrets)) {
                    error("secret not found: " value); next
                }
            }
            # Include overwritten requests in the review, but never values.
            if (ENVIRON["ENVY_MAP_REQUESTS"] != "")
                print alias "=" (kind == "secret" ? value : "__literal__") >> ENVIRON["ENVY_MAP_REQUESTS"]
            if (!(alias in values)) order[++total] = alias
            values[alias] = value
            kinds[alias] = kind
        }
        END {
            if (failed) exit 1
            for (i = 1; i <= total; i++)
                # Sentinels preserve empty values and tabs through shell read.
                print order[i] "\t" kinds[order[i]] "\t." values[order[i]] "."
        }
    ' "$envy_temp/names" "$@"; then
        return 0
    fi
    cat "$envy_temp/errors" >&2
    return 1
)

envy_project() {
    [ "$#" -ge 1 ] || envy_error 'usage: envy project ls|show|edit|rm [name]'
    envy_project_action=$1
    shift
    case $envy_project_action in
        ls) [ "$#" -eq 0 ] || envy_error 'usage: envy project ls' ;;
        show|edit|rm)
            [ "$#" -eq 1 ] || envy_error "usage: envy project $envy_project_action <name>"
            if [ "$1" != --global ] || [ "$envy_project_action" = rm ]; then
                envy_project_name "$1"
            fi
            ;;
        *) envy_error 'usage: envy project ls|show|edit|rm [name]' ;;
    esac
    case $envy_project_action in
        edit|rm) envy_begin ;;
    esac
    envy_require_store
    if [ "$envy_project_action" != ls ]; then
        case $1 in
            --global) envy_map_path=global ;;
            *) envy_map_path=projects/$1/map ;;
        esac
        envy_map=$envy_store/$envy_map_path
    fi
    case $envy_project_action in
        ls)
            for envy_project_dir in "$envy_store"/projects/*; do
                [ -f "$envy_project_dir/map" ] || continue
                printf '%s\n' "${envy_project_dir##*/}"
            done
            ;;
        show)
            if [ "$1" = --global ] && [ ! -e "$envy_map" ]; then
                return
            fi
            [ -f "$envy_map" ] || envy_error "project not found: $1"
            cat "$envy_map"
            ;;
        edit)
            envy_clean_store
            envy_temp=$(mktemp -d "$envy_data/.project.XXXXXX") || envy_error 'cannot create temporary directory'
            if [ -f "$envy_map" ]; then
                cp "$envy_map" "$envy_temp/map"
            else
                : > "$envy_temp/map"
            fi
            # EDITOR is a user-supplied shell command and may include options.
            sh -c 'exec '"${EDITOR:-vi}"' "$1"' envy-editor "$envy_temp/map" ||
                envy_error 'project editor failed; mapping not saved'
            envy_resolve "$envy_temp/map" "$envy_map" > "$envy_temp/table" || exit 1
            if [ -f "$envy_map" ] && cmp -s "$envy_map" "$envy_temp/map"; then
                return
            fi
            mkdir -p "${envy_map%/*}"
            mv "$envy_temp/map" "$envy_map"
            git -C "$envy_store" add -- "$envy_map_path"
            envy_commit_push "project edit $1"
            ;;
        rm)
            envy_clean_store
            [ -f "$envy_store/projects/$1/map" ] || envy_error "project not found: $1"
            git -C "$envy_store" rm -r --quiet -- "projects/$1"
            envy_commit_push "project rm $1"
            ;;
    esac
}

envy_environment_snapshot() {
    envy_snapshot_project || exit 1
    if [ -n "$envy_inproject" ] && ! envy_project_approved; then
        envy_error "$envy_inproject: unapproved or changed mapping; run envy allow"
    fi
}

envy_environment_table() {
    # Build layers in a subshell so the child command arguments stay intact.
    (
        set --
        if [ -e "$envy_store/global" ]; then
            set -- "$@" "$envy_store/global" "$envy_store/global"
        fi
        if [ -n "$envy_selected_project" ]; then
            envy_map=$envy_store/projects/$envy_selected_project/map
            [ -f "$envy_map" ] || envy_error "project not found: $envy_selected_project"
            set -- "$@" "$envy_map" "$envy_map"
        fi
        if [ -n "$envy_inproject" ]; then
            set -- "$@" "$envy_temp/in-project" "$envy_inproject"
        fi
        envy_resolve "$@"
    ) > "$envy_temp/table" || exit 1
}

envy_environment_exports() {
    : > "$envy_temp/exports"
    while IFS="$(printf '\t')" read -r envy_alias envy_kind envy_value; do
        envy_value=${envy_value#.}
        envy_value=${envy_value%.}
        if [ "$envy_kind" = secret ]; then
            envy_secret=$envy_value
            envy_value=$(
                age -d -i "$envy_identity" "$envy_store/secrets/$envy_secret.age" 2> /dev/null || exit 1
                printf '.'
            ) || envy_error "could not decrypt secret: $envy_secret"
            # A sentinel keeps command substitution from stripping newlines.
            envy_value=${envy_value%.}
        fi
        # Give sed a final newline even for an unterminated value, then remove
        # just that added newline so BSD and GNU sed produce the same result.
        envy_quoted=$(printf '%s\n' "$envy_value" | LC_ALL=C sed "s/'/'\\\\''/g"; printf '.')
        envy_quoted=${envy_quoted%.}
        envy_quoted=${envy_quoted%?}
        if [ "${envy_environment_command-}" = hook ]; then
            # Remove inherited integer/array attributes before assigning text;
            # otherwise the shell can interpret a secret as arithmetic.
            printf 'unset %s || return 1\n' "$envy_alias" >> "$envy_temp/exports"
            printf "export %s='%s' || return 1\n" "$envy_alias" "$envy_quoted" >> "$envy_temp/exports"
        else
            printf "export %s='%s'\n" "$envy_alias" "$envy_quoted" >> "$envy_temp/exports"
        fi
    done < "$envy_temp/table"
}

envy_environment() {
    envy_environment_command=$1
    shift
    envy_selected_project=
    if [ "${1-}" = --project ]; then
        [ "$#" -ge 2 ] || envy_error "usage: envy $envy_environment_command [--project <name>] (run requires -- cmd...)"
        envy_project_name "$2"
        envy_selected_project=$2
        shift 2
    fi
    case $envy_environment_command in
        env) [ "$#" -eq 0 ] || envy_error 'usage: envy env [--project <name>]' ;;
        run)
            if [ "$#" -lt 2 ] || [ "$1" != -- ]; then
                envy_error 'usage: envy run [--project <name>] -- cmd...'
            fi
            shift
            envy_inherited_umask=$(umask)
            ;;
    esac
    envy_prepare
    envy_require_store
    envy_temp=$(mktemp -d "$envy_data/.env.XXXXXX") || envy_error 'cannot create temporary directory'
    if [ -z "$envy_selected_project" ]; then
        envy_directory_project
    else
        envy_directory_root
    fi
    envy_environment_snapshot
    envy_environment_table || exit 1
    envy_environment_exports || exit 1
    case $envy_environment_command in
        env) cat "$envy_temp/exports" ;;
        run)
            envy_exports=$(cat "$envy_temp/exports")
            # Finish cleanup before aliases can replace any script variables.
            envy_cleanup
            trap - 0 HUP INT TERM
            umask "$envy_inherited_umask"
            # Shell-special variables (for example OPTIND) can reject a value
            # with a fatal diagnostic containing it. Suppress that diagnostic
            # and report a fixed error even when eval exits the shell directly.
            trap 'printf "%s\n" "envy: could not export project environment" >&2' 0
            eval "$envy_exports" 2> /dev/null
            trap - 0
            exec "$@"
            ;;
    esac
}

envy_hook() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy hook'
    cat <<'HOOK'
_envy_unload() {
    _ENVY_UNLOAD_COUNT=0
    _ENVY_LOAD_COUNT=0
    _ENVY_REMAINING=${_ENVY_VARS-}
    while [ -n "$_ENVY_REMAINING" ]; do
        _ENVY_ALIAS=${_ENVY_REMAINING%% *}
        case $_ENVY_REMAINING in
            *' '*) _ENVY_REMAINING=${_ENVY_REMAINING#* } ;;
            *) _ENVY_REMAINING= ;;
        esac
        case $_ENVY_ALIAS in
            ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*|ENVY_*|_ENVY_*) continue ;;
        esac
        if eval '[ "${_ENVY_SAVED_'"$_ENVY_ALIAS"'+x}" = x ]'; then
            eval 'export '"$_ENVY_ALIAS"'="${_ENVY_SAVED_'"$_ENVY_ALIAS"'}"' 2> /dev/null || :
            unset "_ENVY_SAVED_$_ENVY_ALIAS"
        else
            unset "$_ENVY_ALIAS"
        fi
        _ENVY_UNLOAD_COUNT=$((_ENVY_UNLOAD_COUNT + 1))
    done
    unset _ENVY_VARS
}
_envy_hook() {
    _ENVY_STATUS=$?
    if [ "${_ENVY_PWD-}" != "$PWD" ]; then
        _ENVY_PWD=$PWD
        _ENVY_UNLOAD_COUNT=0
        _ENVY_LOAD_COUNT=0
        if ! _ENVY_CODE=$(command envy hook-env); then
            _ENVY_CODE='_envy_unload; unset _ENVY_FP'
        fi
        if ! eval "$_ENVY_CODE" 2> /dev/null; then
            _envy_unload
            unset _ENVY_FP
            printf '%s\n' 'envy: could not export project environment' >&2
        fi
        unset -f _envy_apply 2> /dev/null || :
        if [ "$_ENVY_UNLOAD_COUNT" -gt 0 ]; then
            printf 'envy: unloaded %s vars\n' "$_ENVY_UNLOAD_COUNT" >&2
        fi
        if [ "$_ENVY_LOAD_COUNT" -gt 0 ]; then
            printf 'envy: loaded %s vars\n' "$_ENVY_LOAD_COUNT" >&2
        fi
        unset _ENVY_CODE
    fi
    return "$_ENVY_STATUS"
}
envy() {
    if command envy "$@"; then _ENVY_COMMAND_STATUS=0; else _ENVY_COMMAND_STATUS=$?; fi
    unset _ENVY_PWD
    return "$_ENVY_COMMAND_STATUS"
}
if [ -z "${_ENVY_HOOK_INSTALLED-}" ]; then
    if [ -n "${ZSH_VERSION-}" ]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook precmd _envy_hook
        _ENVY_HOOK_INSTALLED=1
    elif [ -n "${BASH_VERSION-}" ]; then
        PROMPT_COMMAND="_envy_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
        _ENVY_HOOK_INSTALLED=1
    fi
fi
HOOK
}

# The fingerprint uses metadata only; subdirectory transitions never decrypt.
# Keep emitted code buffered until trust, mappings and every decryption succeed.
envy_hook_resolve() (
    envy_require_store || exit 1
    envy_environment_command=hook
    envy_selected_project=
    envy_directory_project
    envy_environment_snapshot
    envy_revision=$(git -C "$envy_store" rev-parse HEAD) || envy_error 'cannot read store revision'
    envy_fingerprint=$(
        printf '%s\n' "$envy_root" "$envy_selected_project" "$envy_revision" "${envy_inproject_hash-}"
        for envy_map in "$envy_store/global" "$envy_store/projects/$envy_selected_project/map"; do
            [ ! -e "$envy_map" ] || git hash-object --stdin < "$envy_map" || exit 1
        done
    ) || envy_error 'cannot fingerprint mappings'
    envy_fingerprint=$(printf '%s\n' "$envy_fingerprint" | git hash-object --stdin) ||
        envy_error 'cannot fingerprint environment'
    [ "$envy_fingerprint" != "${_ENVY_FP-}" ] || exit 0
    envy_environment_table || exit 1
    envy_environment_exports || exit 1
    printf '%s\n' '_envy_unload'
    envy_vars=
    envy_count=0
    while IFS="$(printf '\t')" read -r envy_alias envy_kind envy_value; do
        # Capture originals in the parent shell, where even unexported values
        # are visible. Identifier validation happens in the mapping resolver.
        printf "if [ \"\${%s+x}\" = x ]; then export _ENVY_SAVED_%s=\"\$%s\"; fi\n" \
            "$envy_alias" "$envy_alias" "$envy_alias"
        envy_vars=${envy_vars:+$envy_vars }$envy_alias
        envy_count=$((envy_count + 1))
    done < "$envy_temp/table"
    printf "export _ENVY_VARS='%s'\n" "$envy_vars"
    printf '%s\n' '_envy_apply() {'
    cat "$envy_temp/exports"
    printf "export _ENVY_FP='%s'\n" "$envy_fingerprint"
    printf '_ENVY_LOAD_COUNT=%s\n' "$envy_count"
    printf '%s\n' '}' '_envy_apply'
)

envy_hook_env() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy hook-env'
    envy_prepare
    envy_temp=$(mktemp -d "${TMPDIR:-/tmp}/envy-hook.XXXXXX") || envy_error 'cannot create temporary directory'
    if envy_hook_resolve > "$envy_temp/code" 2> "$envy_temp/error"; then
        cat "$envy_temp/code"
    else
        # One diagnostic per failed evaluation, even for many mapping errors.
        LC_ALL=C awk 'NR == 1 { print; exit }' "$envy_temp/error" >&2
        printf '%s\n' '_envy_unload' 'unset _ENVY_FP'
    fi
}

envy_check() {
    [ "$#" -eq 0 ] || envy_error 'usage: envy check'
    envy_prepare
    envy_require_store
    envy_temp=$(mktemp -d "$envy_data/.check.XXXXXX") || envy_error 'cannot create temporary directory'
    envy_resolve_references=$envy_temp/references
    : > "$envy_resolve_references"
    envy_resolve > /dev/null || exit 1
    envy_check_failed=0
    if ! envy_remote_project > /dev/null; then
        envy_check_failed=1
    fi
    for envy_map in "$envy_store/global" "$envy_store"/projects/*/map; do
        [ -e "$envy_map" ] || continue
        if ! envy_resolve "$envy_map" "$envy_map" > /dev/null; then
            envy_check_failed=1
        fi
    done
    envy_directory_root
    # Validation is useful before approval and does not load any environment.
    if envy_snapshot_project; then
        if [ -n "$envy_inproject" ] &&
            ! envy_resolve "$envy_temp/in-project" "$envy_inproject" > /dev/null; then
            envy_check_failed=1
        fi
    else
        envy_check_failed=1
    fi
    # References include overwritten assignments, but exclude literal text.
    LC_ALL=C awk '
        FILENAME == ARGV[1] { referenced[$0] = 1; next }
        !($0 in referenced) { print "envy: unreferenced secret: " $0 }
    ' "$envy_resolve_references" "$envy_temp/names"
    return "$envy_check_failed"
}

case ${1-help} in
    run|env)
        envy_environment "$@"
        ;;
    pull|push|sync)
        envy_sync_command "$@"
        ;;
    init|unlock|set|get|ls|project|check|link|unlink|allow)
        envy_command=$1
        shift
        "envy_$envy_command" "$@"
        ;;
    hook)
        shift
        envy_hook "$@"
        ;;
    hook-env)
        shift
        envy_hook_env "$@"
        ;;
    version|help)
        if [ "$#" -gt 1 ]; then
            printf '%s\n' 'envy: unexpected arguments; run envy help' >&2
            exit 1
        fi
        case ${1-help} in
            version) printf '%s\n' 'envy 0.1.0-dev' ;;
            help) envy_help ;;
        esac
        ;;
    *)
        printf '%s\n' 'envy: unknown command; run envy help' >&2
        exit 1
        ;;
esac
